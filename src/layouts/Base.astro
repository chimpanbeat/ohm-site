---
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, indexable, bookingUrl } from '../data/site.ts';
import { analytics } from '../data/analytics.ts';
import { policiesPdfPath } from '../data/client-policies.ts';
import { isExcluded, type Rules } from '../lib/analytics.ts';
import { href } from '../lib/url.ts';
import dmSansUrl from '../assets/fonts/dm-sans-latin-var.woff2?url';
import sairaUrl from '../assets/fonts/saira-semi-condensed-latin-700.woff2?url';
import ogSource from '../assets/about-landscape.jpg';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata; // link-preview art (events, §B10); unset: the About landscape crop
  ogAlt?: string;
  noindex?: boolean;
  bare?: boolean; // /hello only: no skip link, Header or Footer
  analytics?: boolean; // false on pages that must never load analytics; /body-map is also blocked by path (I-115)
}

const { title, description, ogImage, ogAlt, noindex = false, bare = false, analytics: analyticsProp = true } = Astro.props;
// build.format is 'file': drop '.html' / 'index.html' so canonicals match the clean URLs we link to.
const canonical = new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, ''), Astro.site);

// Default OG image: a 1200x630 crop of the landscape photo, as an absolute URL.
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site);

// Link preview: the default photo, or `ogImage` cropped to 1.905:1 and never upscaled (ARCHITECTURE §B3).
let social = { url: ogUrl, width: 1200, height: 630 };
if (ogImage) {
  let w = Math.min(1200, ogImage.width);
  let h = Math.round(w / 1.905);
  if (h > ogImage.height) {
    h = ogImage.height;
    w = Math.round(h * 1.905);
  }
  const img = await getImage({ src: ogImage, width: w, height: h, fit: 'cover', format: 'jpeg' });
  social = { url: new URL(img.src, Astro.site), width: w, height: h };
}

// Umami (A1). Off on the excluded pages (I-115) whatever a page passes; the rest of the tags are built from site data.
const withAnalytics = analyticsProp && !isExcluded(Astro.url.pathname, analytics.excludedPaths, site.deploy.base);
const analyticsRules: Rules = {
  book: (['office', 'central', 'midnorth', 'north'] as const).map(bookingUrl),
  contact: [site.contact.lead, site.contact.chat],
  policies: href(policiesPdfPath),
};

// LocalBusiness JSON-LD (brief §11). No street address, ever.
const prices = Object.values(site.rates).map((r) => r.price);
// No licensure fields and never the license number (I-035, I-027).
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.name,
  url: new URL(href('/'), Astro.site).href,
  email: site.email,
  image: ogUrl.href,
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  priceRange: `$${Math.min(...prices)}–$${Math.max(...prices)}`,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!indexable || noindex) && <meta name="robots" content="noindex" />}

    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sairaUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social.url} />
    <meta property="og:image:width" content={social.width} />
    <meta property="og:image:height" content={social.height} />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={social.url} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {withAnalytics && (
      <>
        <script defer src={analytics.scriptSrc} data-website-id={analytics.websiteId} data-domains={analytics.domain}></script>
        {!bare && <meta name="analytics-rules" content={JSON.stringify(analyticsRules)} />}
      </>
    )}
  </head>
  <body>
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
    {withAnalytics && !bare && <script>import '../scripts/analytics.ts';</script>}
  </body>
</html>
