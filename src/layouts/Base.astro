---
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, indexable } from '../data/site.ts';
import { href } from '../lib/url.ts';
import dmSansUrl from '../assets/fonts/dm-sans-latin-var.woff2?url';
import sairaUrl from '../assets/fonts/saira-semi-condensed-latin-700.woff2?url';
import ogSource from '../assets/about-landscape.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bare?: boolean; // /hello only: no skip link, Header or Footer
}

const { title, description, noindex = false, bare = false } = Astro.props;
// build.format is 'file': drop '.html' / 'index.html' so canonicals match the clean URLs we link to.
const canonical = new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, ''), Astro.site);

// Default OG image: a 1200x630 crop of the landscape photo, as an absolute URL.
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site);

// LocalBusiness JSON-LD (brief §11). No street address, ever.
const prices = Object.values(site.rates).map((r) => r.price);
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.name,
  url: new URL(href('/'), Astro.site).href,
  email: site.email,
  image: ogUrl.href,
  areaServed: site.areaServed.map((name) => ({ '@type': 'City', name })),
  priceRange: `$${Math.min(...prices)}–$${Math.max(...prices)}`,
};
// TODO(Brian): licensure fields are minimal (license number only); confirm what to publish on license day.
if (site.licensed && site.licenseNumber) {
  jsonLd.hasCredential = {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'license',
    identifier: site.licenseNumber,
  };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!indexable || noindex) && <meta name="robots" content="noindex" />}

    <link rel="preload" href={dmSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sairaUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    {!bare && <a class="skip-link" href="#main">Skip to content</a>}
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
