---
import Base from '../layouts/Base.astro';
import BookCta from '../components/BookCta.astro';
import PaymentNotice from '../components/PaymentNotice.astro';
import PriceTable from '../components/PriceTable.astro';
import { site } from '../data/site.ts';
import { terms } from '../data/client-policies.ts';
import { href } from '../lib/url.ts';
const countWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
---

<Base
  title="Pricing · Ohm Precision Bodywork"
  description="Rates for 60- and 90-minute neuromuscular therapy sessions in Colorado Springs, at my office or at your place, and how the mobile travel fee works."
>
  <section class="section">
    <div class="container">
      <h1>Pricing</h1>
      <p>Same session rates at my office or at your place. Mobile sessions add a flat ${site.travelFee.amount} travel fee, and one fee covers up to {countWords[terms.groupMax]} back-to-back sessions at the same address.</p>
    </div>
  </section>

  <section class="section band-light">
    <div class="container stack">
      <PriceTable />

      <h2>Travel fee</h2>
      <p>${site.travelFee.amount}. {site.travelFee.note}</p>
      <p>Where you are decides which days I can come to you. The <a href={href('/book')}>booking page</a> works it out from your address.</p>
      <p>Cancellations, packages and payment are covered in my <a href={href('/client-policies')}>client policies</a>.</p>
    </div>
  </section>

  <section class="section section--end">
    <div class="container">
      <PaymentNotice />
      <BookCta />
    </div>
  </section>
</Base>

<style>
  .stack > * + * {
    margin-top: var(--s-4);
  }
  .stack > h2 {
    margin-top: var(--s-12);
  }
</style>
