---
import Base from '../layouts/Base.astro';
import BookCta from '../components/BookCta.astro';
import PaymentNotice from '../components/PaymentNotice.astro';
import Dropdown from '../components/Dropdown.astro';
import PriceTable from '../components/PriceTable.astro';
import { site } from '../data/site.ts';
import { terms } from '../data/client-policies.ts';
import { href } from '../lib/url.ts';
const countWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
---

<Base
  title="Pricing · Ohm Precision Bodywork"
  description="Rates for 60- and 90-minute neuromuscular therapy sessions in Colorado Springs, at my office or at your place, and how the mobile travel fee works."
>
  <section class="section">
    <div class="container">
      <h1>Pricing</h1>
      <p>Session rates at my office or at your place.</p>
    </div>
  </section>

  <section class="section band-light">
    <div class="container stack">
      <PriceTable />

      <Dropdown title="Travel info" level={2}>
        <p>${site.travelFee.amount}. {site.travelFee.note}</p>
        <p>At a household or with a small group, one fee covers up to {countWords[terms.groupMax]} back-to-back sessions at the same address, as my schedule allows.</p>
        <p>When I come to you, I bring a massage table, sheets and any extras your session needs, so there's nothing for you to set up.</p>
      </Dropdown>

      <p>Cancellations, packages and payment are covered in my <a href={href('/client-policies')}>client policies</a>.</p>
    </div>
  </section>

  <section class="section section--end">
    <div class="container">
      <PaymentNotice />
      <BookCta />
    </div>
  </section>
</Base>

<style>
  .stack > * + * {
    margin-top: var(--s-4);
  }
  .stack > :global(.dropdown) {
    max-width: 44rem; /* as wide as the rate cards */
    margin-top: var(--s-8);
    margin-bottom: var(--s-6);
  }
  .stack > h2 {
    margin-top: var(--s-12);
  }
</style>
