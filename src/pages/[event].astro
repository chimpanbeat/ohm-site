---
import Base from '../layouts/Base.astro';
import EventHero from '../components/events/EventHero.astro';
import EventDescription from '../components/events/EventDescription.astro';
import EventTimeline from '../components/events/EventTimeline.astro';
import EventInfo from '../components/events/EventInfo.astro';
import EventNotice from '../components/events/EventNotice.astro';
import EventCredits from '../components/events/EventCredits.astro';
import RsvpForm from '../components/events/RsvpForm.astro';
import { events } from '../data/events.ts';
import { site } from '../data/site.ts';
import { dateLabel, eventPaths, timeLabel } from '../lib/events.ts';
import { eventAsset } from '../lib/event-assets.ts';

// One page per entry in src/data/events.ts (ARCHITECTURE §B10); the guards run here, so a bad event fails the build.
export function getStaticPaths() {
  return eventPaths(events);
}

const { event } = Astro.props;
const description = `${dateLabel(event.start, event.timeZone)}, ${timeLabel(event.start, event.end, event.timeZone, 'always')} at ${event.venue.name}. ${event.summary}`;
---

<Base
  title={`${event.title} · ${site.name}`}
  description={description}
  ogImage={eventAsset(event.graphics.og)}
  ogAlt={event.graphics.alt}
  noindex={!event.index}
>
  <section class="section">
    <div class="container">
      <EventHero event={event} />
    </div>
  </section>

  <section class="section band-light">
    <div class="container">
      <EventDescription event={event} />
      <EventTimeline event={event} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      {event.info.map((block) => <EventInfo block={block} />)}
    </div>
  </section>

  {
    event.rsvp && (
      <section class="section band-light" id="rsvp">
        <div class="container">
          <RsvpForm event={event} />
        </div>
      </section>
    )
  }

  {
    event.notices.length > 0 && (
      <section class="section">
        <div class="container">
          {event.notices.map((notice) => (
            <EventNotice notice={notice} />
          ))}
        </div>
      </section>
    )
  }

  {
    event.credits && (
      <section class="section band-light">
        <div class="container">
          <EventCredits event={event} />
        </div>
      </section>
    )
  }
</Base>
