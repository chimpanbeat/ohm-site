---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url.ts';
import graphic from '../assets/graphic-green.png';
import omega from '../data/omega.json';

const [, , vbW, vbH] = omega.viewBox.split(' ').map(Number);
---

<Base
  title="Ohm Precision Bodywork · Take the path of least resistance"
  description="Neuromuscular therapy in Colorado Springs for climbers, runners and active people. Trigger point therapy and sports recovery, at your place or my office."
  noindex
  bare
>
  <a class="hello" href={href('/')}>
    <span class="visually-hidden">Enter Ohm Precision Bodywork. </span>
    <Image
      class="hello-art"
      src={graphic}
      alt=""
      widths={[480, 800, 1200]}
      sizes="100vw"
      formats={['avif', 'webp']}
      loading="eager"
      fetchpriority="high"
    />
    <svg class="hello-omega" viewBox={omega.viewBox} style={`aspect-ratio: ${vbW} / ${vbH}`} aria-hidden="true" focusable="false">
      <path class="omega-fill" d={omega.d}></path>
      <g class="omega-glow-wrap"><path class="omega-glow" d={omega.d} pathLength="1"></path></g>
      <path class="omega-light" d={omega.d}></path>
      <path class="omega-glow omega-pulse" d={omega.d}></path>
    </svg>
    <span class="hello-line">Take the path of least resistance</span>
    <span class="hello-cue" aria-hidden="true">Enter</span>
  </a>
</Base>

<script is:inline>
  // The pause before the page goes to Home, so a click shows the glow. Without JS the link just navigates.
  const a = document.querySelector('.hello');
  a.addEventListener('click', (e) => {
    if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    if (a.classList.contains('is-entering')) return;
    a.classList.add('is-entering');
    setTimeout(() => { location.href = a.href; }, 500);
  });
  addEventListener('pageshow', (e) => { if (e.persisted) a.classList.remove('is-entering'); });
</script>

<style>
  /* /hello never scrolls, so the global reserved scrollbar gutter would only cut the art off at the right. */
  :global(html:has(.hello)) {
    scrollbar-gutter: auto;
  }
  .hello {
    --omega-w: min(75vmin, 42rem); /* the Ω svg width */
    --line-fs: max(0.8125rem, calc(var(--omega-w) / 26.54)); /* 13px floor on phones */
    --breathe-delay: 1.5s; /* the breath starts during the lap, so there is never a dead moment */
    --line-ls: calc((var(--omega-w) / 1.04 - 17.84 * var(--line-fs)) / 32); /* fills the gap to the Ω's edges */
    position: relative;
    display: grid;
    place-items: center;
    place-content: center;
    gap: var(--s-6);
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: var(--bg-dark);
    color: var(--text-on-dark);
    text-decoration: none;
    cursor: pointer;
  }
  .hello-art {
    position: absolute;
    top: 0;
    right: -8%;
    height: 100%;
    width: auto;
    max-width: none;
    opacity: 0.9;
    pointer-events: none;
  }
  @media (min-width: 48rem) {
    .hello-art {
      /* Fade the art's left edge into the green, as on the Home hero, so it doesn't read as a box. */
      mask-image: linear-gradient(to right, transparent, black 30%);
    }
  }
  .hello-omega {
    position: relative;
    width: var(--omega-w);
    height: auto;
    overflow: visible;
    animation: ohm-breathe 6s ease-in-out var(--breathe-delay) infinite; /* in step with the line, so its letter-spacing keeps fitting the Ω */
  }
  .omega-fill {
    fill: var(--accent);
  }
  .omega-light,
  .omega-glow {
    fill: none;
    stroke: var(--text-on-dark);
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  /* One dash, longer period than the path, so it never shows twice: at 702 it sits just before the start, at
     -5012 it has run off the end. The lap starts and ends at the right foot's inner corner. The numbers are
     viewBox units, measured on the traced path (length 5011.6, dash 14% of it). They are not written with
     pathLength: a browser that ignores pathLength on dashes (Safari) reads 0.14 and 1 as pixels and draws a
     dusting of dots over the whole Ω. Stroke widths are viewBox units too: a screen-pixel stroke breaks the
     dash length (it is then measured in screen px, which runs the light too fast). If omega.json is
     re-traced, re-measure with path.getTotalLength() and update 702, 5012 and 5400. */
  .omega-light {
    stroke-width: 5;
    opacity: 1;
    stroke-dasharray: 702 5400;
    stroke-dashoffset: 702;
    animation: ohm-lap 3s ease-in-out 0.4s 1 forwards; /* one lap, then the breath and the Enter cue take over */
  }
  .omega-glow {
    stroke-width: 8;
    filter: blur(6px);
  }
  /* No glow at rest: hover, keyboard focus and a click (before the page goes to Home) turn it on. */
  .omega-glow-wrap {
    opacity: 0;
    transition: opacity 300ms;
  }
  /* The Ω lights up on each inhale, so touch screens get the signal that hover gives a pointer. */
  .omega-pulse {
    opacity: 0;
    animation: ohm-hello-glow 6s ease-in-out var(--breathe-delay) infinite;
  }
  .hello.is-entering .omega-glow-wrap,
  .hello:focus-visible .omega-glow-wrap {
    opacity: 1;
  }
  /* The line fades in as the lap ends (0.4s + 3s) and stays. Nothing else ever changes its opacity. */
  .hello-line {
    position: relative;
    text-align: center;
    font-weight: 500;
    text-transform: uppercase;
    white-space: nowrap;
    font-size: var(--line-fs);
    letter-spacing: var(--line-ls);
    text-indent: var(--line-ls); /* balances the trailing letter-space */
    color: color-mix(in srgb, var(--text-on-dark) 75%, var(--bg-dark)); /* 6.66:1 on --bg-dark */
    text-shadow: none;
    padding-inline: 0;
    opacity: 0;
    animation:
      ohm-reveal 1s ease-out 3.4s forwards,
      ohm-breathe 6s ease-in-out var(--breathe-delay) infinite; /* a slow breath: 3 s in, 3 s out */
  }

  /* The one thing left to do: it arrives last, after the line, as an outlined button shape. */
  .hello-cue {
    position: relative;
    font-weight: 500;
    text-transform: uppercase;
    font-size: max(0.875rem, calc(var(--line-fs) * 1.15));
    letter-spacing: 0.3em;
    text-indent: 0.3em; /* balances the trailing letter-space */
    padding: var(--s-2) var(--s-6);
    border: 1px solid color-mix(in srgb, var(--text-on-dark) 60%, var(--bg-dark));
    border-radius: 999px;
    color: var(--text-on-dark);
    opacity: 0;
    animation: ohm-reveal 0.8s ease-out 4.2s forwards;
    transition: background-color 300ms, border-color 300ms;
  }
  .hello.is-entering .hello-cue,
  .hello:focus-visible .hello-cue {
    border-color: var(--text-on-dark);
    background: color-mix(in srgb, var(--text-on-dark) 14%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .hello:hover .hello-cue {
      border-color: var(--text-on-dark);
      background: color-mix(in srgb, var(--text-on-dark) 14%, transparent);
    }
  }

  @keyframes ohm-lap {
    from { stroke-dashoffset: 702; }
    to { stroke-dashoffset: -5012; }
  }
  @keyframes ohm-reveal {
    to { opacity: 1; }
  }
  @keyframes ohm-hello-glow {
    0%, 100% { opacity: 0; }
    50% { opacity: 0.6; }
  }
  @keyframes ohm-breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  /* Hovering the Ω, not the page: the whole page is the link, so .hello:hover would glow whenever the
     pointer is anywhere in the window (10R). */
  @media (hover: hover) and (pointer: fine) {
    .hello-omega:hover .omega-glow-wrap {
      opacity: 1;
    }
  }
  .hello:focus-visible {
    outline: var(--focus-ring);
    outline-offset: calc(-1 * var(--s-4));
  }

  @media (prefers-reduced-motion: reduce) {
    .hello-omega {
      animation: none;
    }
    .omega-light,
    .omega-pulse {
      display: none;
    }
    .hello-cue {
      animation: none;
      opacity: 1;
      transition: none;
    }
    .hello-line {
      animation: none;
      opacity: 1;
    }
    .omega-glow-wrap {
      transition: none;
    }
  }
</style>
