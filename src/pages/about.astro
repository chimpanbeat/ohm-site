---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BookCta from '../components/BookCta.astro';
import { w } from '../data/wording.ts';
import portrait from '../assets/about-portrait.jpg';
import landscape from '../assets/about-landscape.jpg';

const alt = 'Brian Clarke standing on a sandstone ledge above a forested canyon.';

const portraitWidths = [480, 800, 1200];
const landscapeWidths = [800, 1200, 1600, 2400];
const make = (src: ImageMetadata, format: 'avif' | 'webp' | 'jpeg', widths: number[]) =>
  getImage({ src, format, widths });

const [pAvif, pWebp, lAvif, lWebp, lImg] = await Promise.all([
  make(portrait, 'avif', portraitWidths),
  make(portrait, 'webp', portraitWidths),
  make(landscape, 'avif', landscapeWidths),
  make(landscape, 'webp', landscapeWidths),
  getImage({ src: landscape, format: 'jpeg', width: 1200 }),
]);

const mobileMedia = '(max-width: 47.99rem)';
const mobileSizes = '100vw';
const desktopSizes = '(min-width: 72rem) 72rem, 100vw';
---

<Base
  title="About Brian · Ohm Precision Bodywork"
  description="Brian Clarke spent 12 years as an FPGA design engineer before training in neuromuscular therapy. Evidence-informed bodywork for climbers and athletes in Colorado Springs."
>
  <section class="section">
    <div class="container about">
      <!-- width/height on the portrait sources reserve its aspect ratio on mobile (no layout shift). -->
      <picture>
        <source media={mobileMedia} type="image/avif" srcset={pAvif.srcSet.attribute} sizes={mobileSizes} width={portrait.width} height={portrait.height} />
        <source media={mobileMedia} type="image/webp" srcset={pWebp.srcSet.attribute} sizes={mobileSizes} width={portrait.width} height={portrait.height} />
        <source type="image/avif" srcset={lAvif.srcSet.attribute} sizes={desktopSizes} />
        <source type="image/webp" srcset={lWebp.srcSet.attribute} sizes={desktopSizes} />
        <img
          src={lImg.src}
          width={landscape.width}
          height={landscape.height}
          alt={alt}
          loading="eager"
          decoding="async"
        />
      </picture>

      <h1>About Brian</h1>

      <!-- TODO(Brian): review About draft -->
      <p>My path into {w('practice')} started with my own shoulder surgery and rehab. Yoga and breathwork came next, and with them a lasting interest in how bodies move and recover.</p>
      <p>Before that, I spent 12 years as an FPGA design engineer. Debugging hardware is systematic: observe, form a hypothesis, test, write it down. I assess the body the same way, and I keep clear notes so each session builds on the last.</p>
      <p>{w('training')} Its core is neuromuscular therapy: trigger point release, ischemic compression and PNF.</p>
      <p>I've been climbing for more than five years, and I volunteer with adaptive climbing groups at CityRock. I know what a hard season does to forearms, shoulders and hips.</p>
      <p>My approach is evidence-informed and precise, and it starts from your goals. I'll explain what I find and why I'm working where I am. You should leave understanding your body a little better, with tools for your own recovery.</p>

      <p class="cta-p"><BookCta /></p>
    </div>
  </section>
</Base>

<style>
  picture {
    margin-bottom: var(--s-8);
  }
  picture img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .about h1 {
    margin-bottom: var(--s-6);
  }
  .cta-p {
    margin-top: var(--s-8);
  }
</style>
