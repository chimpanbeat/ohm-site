---
import Base from '../../layouts/Base.astro';
import Credentials from '../../components/Credentials.astro';
import OfficeCard from '../../components/OfficeCard.astro';
import ZoneCard from '../../components/ZoneCard.astro';
import ZonePicker from '../../components/ZonePicker.astro';
import ServiceMap from '../../components/ServiceMap.astro';
import PaymentNotice from '../../components/PaymentNotice.astro';
import { site, zoneOrder, mailHref } from '../../data/site.ts';
import { href } from '../../lib/url.ts';

const key = import.meta.env.PUBLIC_GOOGLE_MAPS_KEY ?? '';
---

<Base
  title="Book a session · Ohm Precision Bodywork"
  description="Find the right booking link for an office or mobile session in Colorado Springs and Manitou Springs."
>
  <script is:inline>document.documentElement.classList.add('book-js');</script>
  <section class="section">
    <div class="container book">
      <h1>Book a session</h1>
      <p>Scheduling and intake forms are handled on PocketSuite. You'll put a card on file when you book, and after the session you can pay by card, cash or Zelle.</p>
      <Credentials />
      <p>Booking means you agree to my <a href={href('/client-policies')}>client policies</a>.</p>

      <fieldset id="where" hidden>
        <legend>Where do you want your session?</legend>
        <label><input type="radio" name="where" value="office" /> At my office</label>
        <label><input type="radio" name="where" value="mobile" /> At your place</label>
      </fieldset>

      <section id="office" aria-labelledby="office-h">
        <OfficeCard />
        <ServiceMap focus="office" id="office-map" />
      </section>

      <section id="mobile" aria-labelledby="mobile-h" data-maps-key={key}>
        <h2 id="mobile-h">Where are you located?</h2>
        <ZonePicker />
        <div id="address-wrap"><div id="address-slot"></div></div>
        <div id="zone-result" aria-live="polite"></div>
        <ServiceMap />
        <p class="boundary">
          Near a boundary or can't find your address? <a href={site.contact.chat}>Chat with me</a> or <a href={mailHref}>send me an email</a>. Boundaries are approximate.
        </p>
      </section>

      {
        zoneOrder.map((zone) => (
          <template data-zone={zone}>
            <ZoneCard zone={zone} headingLevel={3} />
          </template>
        ))
      }
      <template data-zone="out" data-via="address">
        <ZoneCard zone="out" via="address" headingLevel={3} />
      </template>
    </div>
  </section>

  <section class="note-end">
    <div class="container">
      <PaymentNotice at="footnote" />
    </div>
  </section>
</Base>

<script>
  import '../../scripts/book.ts';
</script>

<style>
  [hidden] {
    display: none !important;
  }
  /* With JS, book.ts hides both sections and removes this class on init, so the no-JS fallback never flashes. */
  :global(html.book-js) #office,
  :global(html.book-js) #mobile {
    display: none;
  }
  :global(html.book-js) #where[hidden] {
    display: block !important;
  }
  .book > section,
  .book > fieldset {
    margin-top: var(--s-8);
  }
  fieldset {
    border: 0;
    padding: 0;
    min-width: 0;
  }
  legend {
    font-weight: 700;
    padding: 0;
    margin-bottom: var(--s-3);
  }
  label {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-height: 44px;
    cursor: pointer;
  }
  input[type='radio'] {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--accent);
  }
  /* The address combobox is injected by book.ts, so scoped selectors can't reach it. */
  /* Picking an area (button or map) folds the address field away; deselecting unfolds it. The wrapper's
     row eases between 1fr and 0fr, so the map below slides up and back down with it. */
  #address-wrap {
    display: grid;
    grid-template-rows: 1fr;
    margin-top: var(--s-4);
    transition:
      grid-template-rows 300ms ease,
      margin-top 300ms ease,
      opacity 200ms ease,
      visibility 0s;
  }
  #address-wrap.is-collapsed {
    grid-template-rows: 0fr;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 300ms ease,
      margin-top 300ms ease,
      opacity 200ms ease,
      visibility 0s 300ms;
  }
  #address-wrap.is-collapsed #address-slot {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    #address-wrap,
    #address-wrap.is-collapsed {
      transition: none;
    }
  }
  #address-slot {
    position: relative;
    max-width: 32rem;
    min-height: 0;
  }
  #address-slot :global(label) {
    font-weight: 700;
  }
  #address-slot :global(input) {
    width: 100%;
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--green-700);
    border-radius: var(--radius);
    background: var(--bg-light);
    color: var(--text-on-light);
  }
  #address-slot :global(ul) {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 5;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--green-700);
    background: var(--bg-light);
    color: var(--text-on-light);
  }
  #address-slot :global([role='option']) {
    padding: var(--s-3);
    min-height: 44px;
    cursor: pointer;
  }
  #address-slot :global([role='option'][aria-selected='true']) {
    background: var(--bg-mid);
    color: var(--text-on-dark);
  }
  #zone-result {
    margin-top: var(--s-6);
  }
  #zone-result:empty {
    margin-top: 0;
  }
  .boundary {
    margin-top: var(--s-6);
  }
  /* The payment note sits at the bottom of the page, just above the footer: on a tall window the page
     stretches (main is a column) and the note's section takes the slack above it. */
  :global(main:has(.note-end)) {
    display: flex;
    flex-direction: column;
  }
  .note-end {
    margin-top: auto;
    padding-top: var(--s-12);
    padding-bottom: var(--s-8);
  }
</style>
