---
import Base from '../../layouts/Base.astro';
import OfficeCard from '../../components/OfficeCard.astro';
import ZoneCard from '../../components/ZoneCard.astro';
import ZonePicker from '../../components/ZonePicker.astro';
import ServiceMap from '../../components/ServiceMap.astro';
import { site, zoneOrder, type ZoneKey } from '../../data/site.ts';
import { href } from '../../lib/url.ts';

export function getStaticPaths() {
  return [...zoneOrder, 'office' as const].map((zone) => ({ params: { zone } }));
}

const { zone } = Astro.params as { zone: ZoneKey | 'office' };

// Each zone page gets its own title and description (copy deck → Book).
const meta =
  zone === 'office'
    ? {
        title: 'Book at my office',
        description: `My office in ${site.officeArea}. I'm there ${site.office.days}.`,
      }
    : zone === 'out'
      ? {
          title: site.zones.out.name,
          description: 'I can sometimes travel outside my regular area by request. Get in touch, or book a session at my office.',
        }
      : {
          title: `Book in ${site.zones[zone].name}`,
          description: `Book a mobile session at your place in ${site.zones[zone].name}. I'm there ${site.zones[zone].days}.`,
        };
---

<Base title={`${meta.title} · ${site.name}`} description={meta.description}>
  <section class="section">
    <div class="container book">
      <h1>Book a session</h1>

      <div class="result">
        {zone === 'office' ? <OfficeCard headingLevel={2} /> : <ZoneCard zone={zone} headingLevel={2} />}
      </div>

      <ServiceMap focus={zone} />

      <ZonePicker current={zone === 'office' ? undefined : zone} heading="Not sure? Pick your area." />

      <p class="links">
        <a href={href('/book')}>Back to booking options</a>
        {zone !== 'office' && (
          <>
            {' · '}
            <a href={href('/book/office')}>At my office</a>
          </>
        )}
      </p>
    </div>
  </section>
</Base>

<style>
  .links {
    margin-top: var(--s-8);
  }
</style>
