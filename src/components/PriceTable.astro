---
import { site } from '../data/site.ts';

const rows = Object.values(site.rates);
---

<div class="rate-cards" role="list" aria-label="Session rates">
  {
    rows.map((r) => (
      <div class="rate-card" role="listitem">
        <h3>{r.label}</h3>
        <div class="rate-card__prices">
          <p>
            <span class="rate-card__label">
              <svg class="rate-card__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 21V8l9-5 9 5v13M9 21v-6h6v6" /></svg>At my office
            </span>
            <span class="rate-card__amount">${r.price}</span>
          </p>
          <p>
            <span class="rate-card__label">
              <svg class="rate-card__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 16v-4l3.5-1.5L8 6.5h5.5V12H22v4M2 16h2M9 16h6M20 16h2" /><circle cx="6.5" cy="16.5" r="2" /><circle cx="17.5" cy="16.5" r="2" /></svg>At your place
            </span>
            <span class="rate-card__amount">${r.price + site.travelFee.amount}</span>
            <span class="rate-card__note">includes travel</span>
          </p>
        </div>
      </div>
    ))
  }
</div>

<style>
  .rate-cards {
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 40rem) {
    .rate-cards {
      grid-template-columns: 1fr 1fr;
      max-width: 44rem;
    }
  }
  .rate-card {
    padding: var(--s-6);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-dark);
    color: var(--text-on-dark);
  }
  /* The accent shows as the card's top edge and a rule under its title, full width inside the card's padding; the prices stay cream. */
  .rate-card h3 {
    font-size: var(--fs-h2);
  }
  .rate-card h3::after {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    margin-top: var(--s-3);
    background: var(--accent);
  }
  .rate-card__icon {
    display: inline-block;
    width: 1.75rem;
    height: 1.75rem;
    margin-right: var(--s-2);
    vertical-align: -0.5em;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .rate-card__prices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin-top: var(--s-4);
  }
  .rate-card__prices p {
    margin: 0;
  }
  .rate-card__label,
  .rate-card__amount,
  .rate-card__note {
    display: block;
  }
  .rate-card__label,
  .rate-card__note {
    font-size: var(--fs-small);
  }
  /* Figures and the note line up with the label text, past its icon. */
  .rate-card__amount,
  .rate-card__note {
    padding-left: calc(1.75rem + var(--s-2));
  }
  .rate-card__note {
    line-height: 1.3;
  }
  .rate-card__amount {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
</style>
