---
import { site, telHref, mailHref } from '../data/site.ts';
import { href } from '../lib/url.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <p><a href={telHref} class="num">{site.phone}</a></p>
      <p><a href={mailHref}>{site.email}</a></p>
      <p>{site.serviceAreaSummary}</p>
    </div>
    <div>
      <p><a href={href('/book')}>Book a session</a></p>
      <p class="site-footer__legal">
        &copy; {year} {site.legalName}
      </p>
      {site.licensed && site.licenseNumber && <p class="site-footer__legal">{site.licenseNumber}</p>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    border-top: 1px solid var(--line-dark);
    padding-block: var(--s-12);
    font-size: var(--fs-small);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-8);
  }
  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .site-footer__legal {
    margin-top: var(--s-4);
  }
</style>
