---
import { site, mailHref } from '../data/site.ts';
import { href } from '../lib/url.ts';
import Credentials from './Credentials.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div>
      <Credentials compact />
      <p><a href={mailHref}>{site.email}</a></p>
      <p>{site.serviceAreaSummary}</p>
    </div>
    <div class="site-footer__col">
      <p><a href={href('/client-policies')}>Client policies</a></p>
      <p class="site-footer__legal">
        &copy; {year} {site.legalName}
      </p>
      <p class="site-footer__credit">
        {site.brandCredit.role} by <a href={site.brandCredit.url} target="_blank" rel="noopener">{site.brandCredit.name}<span class="visually-hidden"> (opens in a new tab)</span></a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-dark);
    border-top: 1px solid var(--line-dark);
    padding-block: var(--s-6);
    font-size: var(--fs-small);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--s-4);
  }
  /* Same rhythm in both columns (Nov 9, 2026): lines inside a group touch at the line height, groups are --s-4 apart. The
     global `p + p` gap is too big, so the more specific rule below zeroes it; the © line starts the second group. */
  .site-footer__col :where(p + p) {
    margin-top: 0;
  }
  .site-footer__col .site-footer__legal {
    margin-top: var(--s-4);
  }
  @media (min-width: 48rem) {
    .site-footer {
      padding-block: var(--s-8);
    }
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
  }
</style>
