---
import { site, zoneOrder, type ZoneKey } from '../data/site.ts';
import { href } from '../lib/url.ts';

interface Props {
  current?: ZoneKey;
  /** Omit when a surrounding heading already introduces the list. */
  heading?: string;
}

const { current, heading } = Astro.props;
---

<div class:list={['zone-picker', { 'zone-picker--titled': heading }]}>
  {heading && <h3>{heading}</h3>}
  <ul>
    {
      zoneOrder.map((key) => (
        <li>
          <a
            class="btn btn--quiet"
            href={href(`/book/${key}`)}
            data-zone={key}
            aria-current={key === current ? 'page' : undefined}
          >
            {site.zones[key].name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .zone-picker {
    margin-top: var(--s-4);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--s-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .zone-picker--titled {
    margin-top: var(--s-8);
  }
  /* Each zone button is its map area: the same opaque tint ServiceMap fills the area with. */
  a[data-zone='home'] {
    --tint: var(--zone-home-tint);
  }
  a[data-zone='shared'] {
    --tint: var(--zone-shared-tint);
  }
  a[data-zone='north'] {
    --tint: var(--zone-north-tint);
  }
  a[data-zone='home'],
  a[data-zone='shared'],
  a[data-zone='north'] {
    background: var(--tint);
    border-color: var(--tint);
    color: var(--ink);
  }
  /* Hover keeps the tint; only the underline changes. */
  a[data-zone='home']:hover,
  a[data-zone='shared']:hover,
  a[data-zone='north']:hover {
    background: var(--tint);
    border-color: var(--tint);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  /* "Outside my regular area" has no area on the map: the quiet outline, dashed. */
  a[data-zone='out'] {
    border-style: dashed;
  }

  /* The chosen area (aria-current="page" on /book/<zone>, "true" once book.ts selects it). Zone
     buttons get a ring; "out" inverts to a cream fill. */
  a[data-zone='home'][aria-current],
  a[data-zone='shared'][aria-current],
  a[data-zone='north'][aria-current] {
    box-shadow: 0 0 0 3px var(--text-on-dark);
  }
  a[data-zone='out'][aria-current] {
    background: var(--text-on-dark);
    color: var(--bg-dark);
  }
  /* Linked hover (book.ts): the button whose map area is hovered gets the same ring. */
  a[data-zone].is-hot {
    box-shadow: 0 0 0 3px var(--text-on-dark);
  }
  /* The grey-out the map does, for the buttons: while one is chosen, the others dim. A dimmed
     button that has keyboard focus or is hot comes back to full strength so its ring stays visible. */
  ul:has(a[aria-current]) a:not([aria-current]) {
    opacity: 0.5;
  }
  ul:has(a[aria-current]) a:not([aria-current]):is(:focus-visible, .is-hot) {
    opacity: 1;
  }
</style>
