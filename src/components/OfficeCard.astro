---
import { site, bookingUrl } from '../data/site.ts';
import DayChips from './DayChips.astro';

interface Props {
  headingLevel?: 2 | 3;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const book = bookingUrl(site.office.linkKey);
---

<div class="card">
  <Heading id="office-h">At my office</Heading>
  <p>{site.officeArea}</p>
  <p>I send the exact address after you book.</p>
  <DayChips days={site.office.days} />
  <p>I'm there {site.office.days}.</p>
  <p>
    <a class="btn" href={book}>Book at the office</a>
  </p>
</div>

<style>
  .card {
    padding: var(--s-6);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
  }
  .card p + p {
    margin-top: var(--s-3);
  }
  .card :global(.days) {
    margin-top: var(--s-4);
  }
  .card :global(.days) + p {
    margin-top: var(--s-3);
  }
  .card p:last-child {
    margin-top: var(--s-6);
  }
</style>
