---
import { site } from '../data/site.ts';
import { w } from '../data/wording.ts';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

{
  site.licensed && (
    <div class:list={['credentials', { 'credentials--compact': compact }]}>
      <p class="credentials__name">{w('credential')}</p>
      <p>
        {w('licensedIn')} <a href={site.licenseVerifyUrl}>{w('verifyLicense')}</a>.
      </p>
    </div>
  )
}

<style>
  .credentials:not(.credentials--compact) {
    margin-bottom: var(--s-6);
  }
  :global(:not(h1)) + .credentials:not(.credentials--compact) {
    margin-top: var(--s-4);
  }
  .credentials p {
    margin: 0;
  }
  .credentials__name {
    font-weight: 600;
  }
</style>
