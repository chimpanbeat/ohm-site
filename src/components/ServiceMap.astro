---
// Service-area map: an inline SVG drawn at build time from zones.geojson and osm.geojson
// (docs/build/ARCHITECTURE.md §B4). No tiles, no map library, nothing fetched at runtime.
// book.ts swaps the viewBox, the is-focused / is-muted classes and the pin on /book.
import { site, zoneOrder, type ZoneKey } from '../data/site.ts';
import { bboxOf, type ZoneCollection } from '../lib/geo.ts';
import { makeFrame, viewBoxAttr } from '../lib/mapview.ts';
import { href } from '../lib/url.ts';
import zonesRaw from '../data/zones.geojson?raw';
import osmRaw from '../data/osm.geojson?raw';
import terrainImg from '../assets/terrain.webp';
import terrain from '../data/terrain.json';
import omega from '../data/omega.json';

interface Props {
  /** A zone to render zoomed with the others dimmed ('out' tints the outside area), or 'office' for the office map (no zones). */
  focus?: ZoneKey | 'office';
  /** Prefixes the title/<desc> ids, so two maps can share a page. */
  id?: string;
}

type Pt = [number, number];
type RegionKey = Exclude<ZoneKey, 'out'>;

interface OsmFeature {
  properties: { kind: 'road' | 'minor' | 'place'; name?: string; major?: boolean };
  geometry: { type: 'MultiLineString'; coordinates: Pt[][] } | { type: 'Point'; coordinates: Pt };
}

const { focus, id = 'map' } = Astro.props;

// Manual label fixes in SVG units: [dx, dy]. Keys are `zone:<key>`, `road:<name>`, `place:<name>`.
const labelNudge: Record<string, [number, number]> = {
  'zone:home': [25, 0],
  'place:Colorado Springs': [10, 35], // clear of the office mark (38.80, -104.85)
  'road:Academy': [75, 0],
  'road:Woodmen': [40, 0],
  'road:Templeton Gap': [75, -30],
  'road:Austin Bluffs': [-40, 20],
  'road:US 24': [40, -35],
  'place:Manitou Springs': [-30, 0],
};
// The office map is zoomed in about 3×, so the full-map nudges would throw its labels kilometres off.
const officeNudge: Record<string, [number, number]> = {
  'road:US 24': [45, 30], // clear of the Manitou Springs label
  'road:Garden of the Gods': [-30, 55], // clear of the "Show mobile service areas" button (top right)
};

// The office mark: the traced Ω (dMap, the 6 px simplification), W map units wide at scale 1.
const markW = 105;
const [, , omegaW, omegaH] = omega.viewBox.split(' ').map(Number);
const markH = Number(((markW * omegaH) / omegaW).toFixed(1));

const zones = JSON.parse(zonesRaw) as ZoneCollection;
const osm = (JSON.parse(osmRaw) as { features: OsmFeature[] }).features;
const frame = makeFrame(zones);
const { full } = frame;

const regions: RegionKey[] = zoneOrder.filter((k): k is RegionKey => k !== 'out');
const office = focus === 'office';
const focused = focus && focus !== 'out' && focus !== 'office' ? (focus as RegionKey) : undefined;
const box = focused ? bboxOf(zones, focused) : null;
const { mapArea } = site.office;
// The office mark sits on the (deliberately vague, 2-decimal) office point.
const [officeX, officeY] = frame.project(mapArea.lng, mapArea.lat);
// Office mode: the Central & Southwest zoom, widened so the mark is never at an edge.
const view = office
  ? frame.include(frame.viewFor(bboxOf(zones, 'home')!), officeX, officeY, 120)
  : box
    ? frame.viewFor(box)
    : full;
const mapScale = Number((full.w / view.w).toFixed(3));

const path = (pts: Pt[], close = false) =>
  'M' + pts.map(([x, y]) => `${x} ${y}`).join('L') + (close ? 'Z' : '');
const nudge = (key: string, [x, y]: Pt): Pt => {
  const [dx, dy] = (office ? officeNudge : labelNudge)[key] ?? [0, 0];
  return [x + dx, y + dy];
};

// Zones, projected: one list of rings (outer first, then holes) per polygon.
const zoneRings = Object.fromEntries(
  regions.map((key) => {
    const f = zones.features.find((feat) => feat.properties.zone === key);
    const polys = !f ? [] : f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : f.geometry.coordinates;
    return [key, polys.map((rings) => rings.map((ring) => ring.map(([lng, lat]) => frame.project(lng, lat))))];
  }),
) as Record<RegionKey, Pt[][][]>;

/** Pole of inaccessibility: the interior point farthest from any edge, by grid search plus one refinement. */
function pole(rings: Pt[][]): Pt {
  const all = rings.flat();
  const edges: [Pt, Pt][] = rings.flatMap((r) => r.map((p, i): [Pt, Pt] => [p, r[(i + 1) % r.length]]));
  const inside = (x: number, y: number) => {
    let hit = false;
    for (const [[ax, ay], [bx, by]] of edges) {
      if (ay > y !== by > y && x < ((bx - ax) * (y - ay)) / (by - ay) + ax) hit = !hit;
    }
    return hit;
  };
  const distance = (x: number, y: number) => {
    let best = Infinity;
    for (const [[ax, ay], [bx, by]] of edges) {
      const dx = bx - ax;
      const dy = by - ay;
      const t = dx || dy ? Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy))) : 0;
      best = Math.min(best, Math.hypot(x - (ax + t * dx), y - (ay + t * dy)));
    }
    return best;
  };
  const search = (x0: number, y0: number, x1: number, y1: number, n: number, from: Pt | null): Pt => {
    let best: Pt = from ?? [(x0 + x1) / 2, (y0 + y1) / 2];
    let bestD = from ? distance(...from) : -1;
    for (let i = 0; i <= n; i++) {
      for (let j = 0; j <= n; j++) {
        const x = x0 + ((x1 - x0) * i) / n;
        const y = y0 + ((y1 - y0) * j) / n;
        if (!inside(x, y)) continue;
        const d = distance(x, y);
        if (d > bestD) {
          bestD = d;
          best = [x, y];
        }
      }
    }
    return best;
  };
  const xs = all.map((p) => p[0]);
  const ys = all.map((p) => p[1]);
  const [x0, x1] = [Math.min(...xs), Math.max(...xs)];
  const [y0, y1] = [Math.min(...ys), Math.max(...ys)];
  const coarse = search(x0, y0, x1, y1, 40, null);
  const dx = (x1 - x0) / 40;
  const dy = (y1 - y0) / 40;
  const [px, py] = search(coarse[0] - dx, coarse[1] - dy, coarse[0] + dx, coarse[1] + dy, 20, coarse);
  return [Number(px.toFixed(1)), Number(py.toFixed(1))];
}

/** Two lines for long zone names, split at the space nearest the middle. */
function lines(name: string): string[] {
  if (name.length <= 14) return [name];
  const mid = name.length / 2;
  const spaces = [...name].flatMap((c, i) => (c === ' ' ? [i] : []));
  const at = spaces.reduce((a, b) => (Math.abs(b - mid) < Math.abs(a - mid) ? b : a));
  return [name.slice(0, at), name.slice(at + 1)];
}

const zoneShapes = regions.map((key) => {
  const polys = zoneRings[key];
  const d = polys.map((rings) => rings.map((ring) => path(ring, true)).join('')).join('');
  const label = nudge(`zone:${key}`, pole(polys.flat()));
  return { key, d, label, text: lines(site.zones[key].name) };
});

// Road labels go where the road is on screen: the full view normally (so they stay put when book.ts
// zooms), the office view for the office map.
const labelBounds = office ? view : full;
const inView = ([x, y]: Pt) =>
  x >= labelBounds.x && x <= labelBounds.x + labelBounds.w && y >= labelBounds.y && y <= labelBounds.y + labelBounds.h;
const lengthOf = (pts: Pt[]) => pts.reduce((sum, p, i) => (i ? sum + Math.hypot(p[0] - pts[i - 1][0], p[1] - pts[i - 1][1]) : 0), 0);

/** A vertex near the middle (by length) of the longest run of the road that is inside the full view. */
function roadLabelAt(lines: Pt[][]): Pt | null {
  let longest: Pt[] = [];
  for (const line of lines) {
    let run: Pt[] = [];
    for (const p of [...line, null]) {
      if (p && inView(p)) {
        run.push(p);
        continue;
      }
      if (run.length > 1 && lengthOf(run) > lengthOf(longest)) longest = run;
      run = [];
    }
  }
  if (longest.length < 2) return null;
  const half = lengthOf(longest) / 2;
  let walked = 0;
  for (let i = 1; i < longest.length; i++) {
    walked += Math.hypot(longest[i][0] - longest[i - 1][0], longest[i][1] - longest[i - 1][1]);
    if (walked >= half) return longest[i];
  }
  return longest[longest.length - 1];
}

// A map with a focus never zooms, so its road lines are clipped to its view plus 5%: keep each run of
// segments that touch that box (a segment that crosses it with both ends outside stays). Only the
// zoomable /book map carries every road. Labels are placed before clipping.
const clipBox = {
  x0: view.x - view.w * 0.05,
  y0: view.y - view.h * 0.05,
  x1: view.x + view.w * 1.05,
  y1: view.y + view.h * 1.05,
};
function clipLines(lines: Pt[][]): Pt[][] {
  if (!focus) return lines;
  const kept: Pt[][] = [];
  for (const line of lines) {
    let run: Pt[] | null = null;
    for (let i = 1; i < line.length; i++) {
      const [a, b] = [line[i - 1], line[i]];
      const touches =
        Math.max(a[0], b[0]) >= clipBox.x0 &&
        Math.min(a[0], b[0]) <= clipBox.x1 &&
        Math.max(a[1], b[1]) >= clipBox.y0 &&
        Math.min(a[1], b[1]) <= clipBox.y1;
      if (!touches) run = null;
      else if (run) run.push(b);
      else kept.push((run = [a, b]));
    }
  }
  return kept;
}

const projectLines = (coords: Pt[][]) => coords.map((line) => line.map(([lng, lat]) => frame.project(lng, lat)));

const roads = osm.flatMap((f) => {
  if (f.properties.kind !== 'road' || f.geometry.type !== 'MultiLineString') return [];
  const lines = projectLines(f.geometry.coordinates);
  const at = roadLabelAt(lines);
  return [
    {
      name: f.properties.name!,
      major: !!f.properties.major,
      d: clipLines(lines).map((l) => path(l)).join(''),
      label: at ? nudge(`road:${f.properties.name}`, at) : null,
    },
  ];
});

// Unlabelled minor roads (npm run osm): one path, drawn thin and faint under the named roads.
const minorD = osm.flatMap((f) =>
  f.properties.kind === 'minor' && f.geometry.type === 'MultiLineString'
    ? [clipLines(projectLines(f.geometry.coordinates)).map((l) => path(l)).join('')]
    : [],
)[0];

// The outside area: a rectangle far larger than the view, with every zone ring as a hole (evenodd).
const outD = (() => {
  const [x0, y0, x1, y1] = [full.x - 5 * full.w, full.y - 5 * full.h, full.x + 6 * full.w, full.y + 6 * full.h];
  const rect = `M${x0} ${y0}L${x1} ${y0}L${x1} ${y1}L${x0} ${y1}Z`;
  return rect + zoneShapes.map((z) => z.d).join('');
})();

// The terrain shadow image covers the OSM box, stretched over its projected corners.
const [terrainX0, terrainY0] = frame.project(terrain.bbox[0], terrain.bbox[3]);
const [terrainX1, terrainY1] = frame.project(terrain.bbox[2], terrain.bbox[1]);

// The office map drops places outside its view; otherwise half a label pokes in at the edge.
const places = osm.flatMap((f) => {
  if (f.properties.kind !== 'place' || f.geometry.type !== 'Point') return [];
  const at = nudge(`place:${f.properties.name}`, frame.project(...f.geometry.coordinates));
  return office && !inView(at) ? [] : [{ name: f.properties.name, at }];
});

const names = regions.map((k) => site.zones[k].name);
const title = office ? 'Office area map' : 'Service area map';
const desc = office
  ? 'Map of southwest Colorado Springs with my logo marking the area my office is in, near Cheyenne Canyon and the Broadmoor. The exact address is sent after you book.'
  : `Map of Colorado Springs showing my three service areas, ${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}, with the major roads that border them.`;
// focus 'out' dims all three zones and tints the outside area; a zone focus dims the other two.
const state = (key: RegionKey) =>
  focused ? (key === focused ? 'is-focused' : 'is-muted') : focus === 'out' ? 'is-muted' : undefined;

// The mark is a pointer-only link to the office on the zone maps (book.ts turns the click into a
// switch to "At my office" on /book); on the office map it is just the marker.
const Mark = office ? 'g' : 'a';
const markProps = office ? {} : { href: href('/book/office'), tabindex: '-1', 'aria-hidden': 'true' };
---

<div class:list={['service-map', { 'service-map--office': office }]}>
  <div class="map-frame">
  {/* The name lives outside the svg: an svg <title> shows as a hover tooltip over the whole map.
      aria-labelledby still reads a hidden element. */}
  <span id={`${id}-title`} hidden>{title}</span>
  <svg
    viewBox={viewBoxAttr(view)}
    data-full={viewBoxAttr(full)}
    style={`--map-scale: ${mapScale}`}
    role="img"
    aria-labelledby={`${id}-title ${id}-desc`}
    preserveAspectRatio="xMidYMid meet"
  >
    <desc id={`${id}-desc`}>{desc}</desc>

    {!office && <path class:list={['zone', 'zone--out', { 'is-focused': focus === 'out' }]} data-zone="out" fill-rule="evenodd" d={outD} />}
    {
      !office &&
        zoneShapes.map((z) => (
          <path class:list={['zone', `zone--${z.key}`, state(z.key)]} data-zone={z.key} fill-rule="evenodd" d={z.d} />
        ))
    }
    <image
      class="terrain"
      href={terrainImg.src}
      x={terrainX0}
      y={terrainY0}
      width={Number((terrainX1 - terrainX0).toFixed(1))}
      height={Number((terrainY1 - terrainY0).toFixed(1))}
      preserveAspectRatio="none"
      aria-hidden="true"
    />
    {minorD && <path class="road road--minor" d={minorD} />}
    {roads.map((r) => <path class:list={['road', { 'road--major': r.major }]} data-road={r.name} d={r.d} />)}
    {
      !office &&
        zoneShapes.map((z) => (
          <path class:list={['zone-line', `zone-line--${z.key}`, state(z.key)]} data-zone={z.key} fill-rule="evenodd" d={z.d} />
        ))
    }
    {
      roads.map(
        (r) =>
          r.label && (
            <g transform={`translate(${r.label[0]} ${r.label[1]})`}>
              <text class="road-label" text-anchor="middle" dy="0.35em">
                {r.name}
              </text>
            </g>
          ),
      )
    }
    {
      places.map((p) => (
        <g transform={`translate(${p.at[0]} ${p.at[1]})`}>
          <text class="place-label" text-anchor="middle" dy="0.35em">
            {p.name}
          </text>
        </g>
      ))
    }
    {
      !office &&
        zoneShapes.map((z) => (
          <g transform={`translate(${z.label[0]} ${z.label[1]})`}>
            <text class:list={['zone-label', state(z.key)]} data-zone={z.key} text-anchor="middle" dy={`${0.35 - (z.text.length - 1) * 0.575}em`}>
              {z.text.map((line, i) => (
                <tspan x="0" dy={i ? '1.15em' : undefined}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))
    }

    <Mark class="map-office" {...markProps}>
      <g transform={`translate(${officeX} ${officeY})`}>
        <g class="office-mark-scale">
          <rect class="office-hit" x={-markW / 2} y={-markH / 2} width={markW} height={markH}></rect>
          <svg class="office-mark" viewBox={omega.viewBox} x={-markW / 2} y={-markH / 2} width={markW} height={markH} overflow="visible">
            <path d={omega.dMap}></path>
          </svg>
          <text class="office-label" y={markH / 2 + 14} text-anchor="middle" dy="0.35em">Ohm Office</text>
        </g>
      </g>
    </Mark>

    {
      !office && (
        <g class="map-pin" hidden>
          {/* 24x32 teardrop, tip at (0,0), drawn at 2.25x: the map is only ~340px wide on a phone. */}
          <g transform="scale(2.25)">
            <path d="M0 0C-4-8-12-14-12-20A12 12 0 1 1 12-20C12-14 4-8 0 0Z" />
            <circle cy="-20" r="4" />
          </g>
        </g>
      )
    }
  </svg>
  {!office && <button type="button" class="map-reset" hidden>Show all areas</button>}
  {office && <a class="map-areas" href={`${href('/book')}#mobile`}>Show mobile service areas</a>}
  </div>

  {
    !office && (
      <>
      <p class="map-link">
        <a class="btn btn--quiet" href={site.mapViewerUrl} target="_blank" rel="noopener">
          Open in Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
          </svg>
          <span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </p>
      <p class="map-hint" hidden>Tap an area on the map or a button above to choose it. Tap it again to see all areas. The Ohm symbol marks my office; tap it for office sessions.</p>
      </>
    )
  }
  <p class="map-credit">
    Roads and places &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>. Terrain: USGS 3DEP.
  </p>
</div>

<style>
  .service-map {
    margin-top: var(--s-8);
    /* Label sizes are in SVG units (the map is 1000 wide). The map is as wide as the screen up to 34rem,
       so smaller screens need bigger units to keep labels near 12–13px. */
    --t-road: 34px;
    --t-zone: 38px;
  }
  @media (min-width: 24rem) {
    .service-map {
      --t-road: 30px;
      --t-zone: 34px;
    }
  }
  @media (min-width: 30rem) {
    .service-map {
      --t-road: 26px;
      --t-zone: 30px;
    }
  }
  @media (min-width: 36rem) {
    .service-map {
      --t-road: 24px;
      --t-zone: 28px;
    }
  }

  .map-frame {
    position: relative;
    max-width: 34rem;
  }
  .map-frame > svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    background: var(--bg-light);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    color: var(--text-on-light);
  }

  /* "Show all areas" (zone maps, while book.ts has the map zoomed) and "Show mobile service areas" (office
     map): over the map's top-right corner, dark so they read on the light map. */
  .map-reset,
  .map-areas {
    position: absolute;
    top: var(--s-2);
    right: var(--s-2);
    min-height: 44px;
    padding-inline: var(--s-3);
    background: var(--bg-dark);
    color: var(--text-on-dark);
    border: 0;
    border-radius: var(--radius);
    box-shadow: 0 1px 4px color-mix(in srgb, var(--ink) 35%, transparent);
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .map-areas {
    display: inline-flex; /* not on .map-reset: it would override that button's `hidden` */
    align-items: center;
  }
  .map-reset:hover,
  .map-areas:hover {
    background: var(--bg-mid);
  }

  /* Zones: the fill takes the click; everything drawn over it lets clicks through.
     The fill is the tint the area buttons use, opaque, so button and map match exactly. */
  .zone {
    fill-opacity: 1;
    stroke: none;
  }
  .zone--home {
    fill: var(--zone-home-tint);
  }
  .zone--shared {
    fill: var(--zone-shared-tint);
  }
  .zone--north {
    fill: var(--zone-north-tint);
  }
  /* The zones that aren't chosen keep their colour, dimmed. */
  .zone.is-muted {
    fill-opacity: 0.35;
  }
  /* Hover (book.ts): the areas other than the hovered one, and the office mark, step back. The hovered
     area shows its full tint even while another area is chosen. */
  .zone.is-dim {
    fill-opacity: 0.35;
  }
  .zone.is-muted.is-hot {
    fill-opacity: 1;
  }
  .map-office.is-dim {
    opacity: 0.5;
  }
  /* Everything outside the zones. Invisible until hovered or chosen, but it takes the click. */
  .zone--out {
    fill: var(--zone-out-tint);
    fill-opacity: 0;
    pointer-events: fill;
  }
  .zone--out.is-hot {
    fill-opacity: 0.6;
  }
  .zone--out.is-focused {
    fill-opacity: 1;
  }
  .is-interactive .zone {
    cursor: pointer;
  }
  .zone-line {
    fill: none;
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  .zone-line--home {
    stroke: var(--zone-home);
  }
  .zone-line--shared {
    stroke: var(--zone-shared);
  }
  .zone-line--north {
    stroke: var(--zone-north);
  }
  .zone-line.is-muted {
    stroke-opacity: 0.25;
  }
  /* Linked hover: book.ts sets is-hot while the matching button or area is hovered or focused. */
  .zone-line.is-hot {
    stroke-width: 4px;
  }

  /* Terrain shadow (npm run terrain): black with alpha, so flat ground keeps the zone tints exact. */
  .terrain {
    opacity: 0.6;
    pointer-events: none;
  }

  /* The office mark: the bare Ω with a cream halo and the label "Ohm Office", the same size at every
     zoom (like the pin). On the zone maps it is a pointer-only link to the office. */
  .office-mark-scale {
    transform: scale(calc(1 / var(--map-scale, 1)));
  }
  .office-mark path {
    fill: var(--accent);
    stroke: var(--bg-light);
    stroke-width: 3px;
    paint-order: stroke;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* The cut-out in the Ω isn't painted, so a transparent box keeps the whole mark clickable. */
  .office-hit {
    fill: transparent;
    stroke: none;
  }
  a.map-office {
    cursor: pointer;
    text-decoration: none; /* the global link underline would otherwise show on the label at rest */
  }
  /* The global text rule switches pointer events off; the label is part of the link, so turn them back on. */
  a.map-office .office-label {
    pointer-events: auto;
  }
  a.map-office:hover .office-mark path {
    stroke-width: 5px;
  }
  a.map-office:hover .office-label {
    text-decoration: underline;
  }
  /* The label sits inside the scaled group, so its size is in the full-view units, not divided again. */
  .office-label {
    font-size: var(--t-zone);
    font-weight: 700;
    stroke-width: 4px;
  }

  .road {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.45;
    stroke-width: 1.5px;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  .road--major {
    stroke-width: 2.5px;
