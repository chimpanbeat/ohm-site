---
import { glossary, type GlossaryKey } from '../data/glossary.ts';

interface Props {
  keys: GlossaryKey[];
}

const { keys } = Astro.props;
---

<dl class="glossary">
  {
    keys.map((k) => (
      <>
        <dt>{glossary[k].term}</dt>
        <dd>{glossary[k].def}</dd>
      </>
    ))
  }
</dl>

<style>
  .glossary {
    margin-top: var(--s-3);
    /* Same gap as p + p, so a following paragraph (About) doesn't sit flush. */
    margin-bottom: var(--s-4);
    max-width: var(--measure);
    font-size: var(--fs-small);
  }
  dt {
    font-weight: 700;
  }
  dd {
    margin: 0 0 var(--s-3);
  }
  dd:last-child {
    margin-bottom: 0;
  }
  dt + dd {
    margin-top: var(--s-1);
  }
</style>
