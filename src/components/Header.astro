---
import { Image } from 'astro:assets';
import logoLine from '../assets/logo-line.png';
import icon from '../assets/icon.png';
import { site } from '../data/site.ts';
import { href } from '../lib/url.ts';
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="site-header__logo" href={href('/')} aria-label={`${site.name}, home`}>
      <span class="logo-full">
        <Image
          class="logo-layer logo-word"
          src={logoLine}
          alt={site.name}
          width={240}
          densities={[2, 3]}
          loading="eager"
        />
        <Image
          class="logo-layer logo-omega"
          src={logoLine}
          alt=""
          aria-hidden="true"
          width={240}
          densities={[2, 3]}
          loading="eager"
        />
      </span>
      <Image
        class="logo-icon"
        src={icon}
        alt={site.name}
        width={48}
        height={48}
        densities={[2, 3]}
        loading="eager"
      />
    </a>
    <nav class="site-header__nav" aria-label="Main">
      <a href={href('/services')}>Services</a>
      <a href={href('/pricing')}>Pricing</a>
      <a href={href('/about')}>About</a>
      <a class="btn" href={href('/book')}>Book</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg-dark);
    border-bottom: 1px solid var(--line-dark);
    view-transition-name: site-header;
  }
  .site-header__row {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  /* The wide logo is one PNG, drawn twice: the wordmark layer and, on top, the Ω layer (the Ω is the left
     21.5% of the image, with a clear gap before the O). At rest they read as one logo. Home only: logo-spin.ts
     adds .is-spinning on a click and the Ω turns once, counter-clockwise, about its own centre. */
  .logo-layer {
    display: block;
    width: 100%;
    height: auto;
  }
  .logo-word {
    clip-path: inset(0 0 0 21.5%);
  }
  .logo-omega {
    position: absolute;
    inset: 0;
    clip-path: inset(0 78.5% 0 0);
    transform-origin: 10.8% 45.3%;
  }
  .site-header__logo.is-spinning .logo-omega,
  .site-header__logo.is-spinning .logo-icon {
    animation: ohm-spin 0.9s ease-in-out 1;
  }
  @keyframes ohm-spin {
    from {
      transform: rotate(0);
    }
    to {
      transform: rotate(-360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__logo.is-spinning .logo-omega,
    .site-header__logo.is-spinning .logo-icon {
      animation: none;
    }
  }
  /* Scroll-linked header (A3 eighth exception): over the first 40px of scroll a green hairline fades in over the
     border and the logo link scales to 0.88. The header box never changes size. Longhands, not the animation
     shorthand: the build's minifier folds a complete shorthand plus timeline into one `animation:` declaration,
     which Chromium rejects, so the animation would never run. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        bottom: -1px;
        height: 1px;
        background: var(--green-300);
        pointer-events: none;
        opacity: 0;
        animation-name: ohm-header-line;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0px 40px;
      }
      .site-header__logo {
        transform-origin: left center;
        animation-name: ohm-header-logo;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0px 40px;
      }
      @keyframes ohm-header-line {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes ohm-header-logo {
        from {
          scale: 1;
        }
        to {
          scale: 0.88;
        }
      }
    }
  }
  .logo-full {
    position: relative;
    display: block;
    width: 200px;
  }
  .logo-icon {
    display: none;
    width: 48px;
    height: 48px;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .site-header__nav a:not(.btn) {
    text-decoration: none;
    padding-block: var(--s-3);
  }
  .site-header__nav a:not(.btn):hover {
    text-decoration: underline;
  }
  .site-header__nav .btn {
    min-height: 44px;
    padding-inline: var(--s-4);
  }
  @media (min-width: 48rem) {
    .logo-full {
      width: 240px;
    }
  }
  /* Four nav items: compact type up to 35.5rem (the full-size row with the 200px logo needs about 565px). */
  @media (max-width: 35.5rem) {
    .logo-full {
      width: 130px;
    }
    .site-header__nav {
      gap: var(--s-3);
      font-size: var(--fs-small);
    }
    .site-header__nav .btn {
      padding-inline: var(--s-3);
    }
  }
  /* Icon-only logo up to 27.5rem: the compact row with the 130px logo needs about 434px. */
  @media (max-width: 27.5rem) {
    .logo-full {
      display: none;
    }
    .logo-icon {
      display: block;
    }
  }
  /* The icon row needs about 352px; below 22.5rem it tightens its gaps and padding (down to 320px). */
  @media (max-width: 22.5rem) {
    .site-header .container {
      padding-inline: var(--s-3);
    }
    .site-header__row,
    .site-header__nav {
      gap: var(--s-2);
    }
    .site-header__nav .btn {
      padding-inline: var(--s-2);
    }
  }
</style>
