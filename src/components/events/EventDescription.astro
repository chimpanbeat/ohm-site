---
// The event description under the hero (E4, I-077): one paragraph per entry, under an H2 from the data (E5, I-085).
import { eventHeadings, type SiteEvent } from '../../data/events.ts';
import EventRich from './EventRich.astro';

interface Props {
  event: SiteEvent;
}

const { description } = Astro.props.event;
---

{
  description && description.length > 0 && (
    <div class="event-description">
      <h2>{eventHeadings.description}</h2>
      {description.map((paragraph) => (
        <p>
          <EventRich text={paragraph} />
        </p>
      ))}
    </div>
  )
}

<style>
  .event-description {
    margin-bottom: var(--s-12);
  }
  .event-description h2 + p {
    margin-top: var(--s-6);
  }
  .event-description p {
    max-width: var(--measure);
  }
  .event-description p + p {
    margin-top: var(--s-4);
  }
</style>
