---
import { eventHeadings, type SiteEvent } from '../../data/events.ts';
import { timeLabel } from '../../lib/events.ts';
import EventRich from './EventRich.astro';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
---

<h2>{eventHeadings.schedule}</h2>
<ol class="timeline">
  {
    event.timeline.map((item) => (
      <li class:list={['timeline__item', { 'timeline__item--optional': item.optional }]}>
        <time class="timeline__time" datetime={item.start}>
          {timeLabel(item.start, item.end, event.timeZone, 'auto')}
        </time>
        <div class="timeline__body">
          <h3>{item.title}</h3>
          {item.notes && item.notes.length > 0 && (
            <ul>
              {item.notes.map((note) => (
                <li>
                  <EventRich text={note} />
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  /* A 2px rule with a 10px square marker per item; an optional item's marker is hollow. */
  .timeline {
    list-style: none;
    margin: var(--s-6) 0 0 5px;
    padding: 0 0 0 var(--s-6);
    border-left: 2px solid var(--line-light);
  }
  .timeline__item {
    position: relative;
  }
  .timeline__item + .timeline__item {
    margin-top: var(--s-6);
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    top: 0.45rem;
    left: calc(-1 * var(--s-6) - 6px);
    width: 10px;
    height: 10px;
    background: var(--accent);
    border: 2px solid var(--accent);
    box-sizing: border-box;
  }
  .timeline__item--optional::before {
    background: var(--bg-light);
  }
  .timeline__time {
    display: block;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .timeline__body ul {
    margin: var(--s-2) 0 0;
    padding-left: 1.1em;
  }
  .timeline__body li + li {
    margin-top: var(--s-1);
  }
  @media (min-width: 48rem) {
    .timeline__item {
      display: grid;
      grid-template-columns: 9rem 1fr;
      column-gap: var(--s-4);
    }
    .timeline__item::before {
      top: 0.5rem;
    }
  }
</style>
