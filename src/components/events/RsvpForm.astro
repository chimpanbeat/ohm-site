---
// The RSVP form (E2, I-049/I-050; ARCHITECTURE §B10). Works without JS: it posts to the Apps Script with
// mode=html. src/scripts/rsvp.ts (client script 5) layers on spots left, validation and the in-page result.
// Every string is rsvpText's; nothing here types copy. maxGuests is a hidden ceiling (I-060): all rows exist,
// rows past NOJS_GUEST_ROWS are `hidden`, and no text names a limit.
import { rsvpText as t, type SiteEvent } from '../../data/events.ts';
import { site } from '../../data/site.ts';
import { timeLabel, googleCalUrl } from '../../lib/events.ts';
import { configOf, fill, words, NOJS_GUEST_ROWS } from '../../lib/rsvp.ts';
import { href } from '../../lib/url.ts';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const cfg = configOf(event);
const session = event.rsvp?.session;
const w = session ? words(session.label) : {};
const item = session ? event.timeline[session.item] : undefined;
const question = session && item ? fill(t.sessionQuestion, { ...w, time: timeLabel(item.start, item.end, event.timeZone, 'auto') }) : '';
const guestsHelp = fill(session ? t.guestsHelp : t.guestsHelpPlain, w);
const googleUrl = googleCalUrl(event, new URL(href('/'), Astro.site).href); // E14
const rows = Array.from({ length: cfg.maxGuests }, (_, i) => i + 1);
const statuses = ['going', 'maybe', 'cant'] as const;
const answers = ['yes', 'no'] as const;
// E9 (I-096): notices whose link is also a result-card button
const notices = event.notices.filter((n): n is typeof n & { link: NonNullable<typeof n.link> } => n.inResult === true && n.link !== undefined);
---

<div class="rsvp">
  <h2 class="rsvp-heading">{t.heading}</h2>
  <p class="rsvp-intro">{t.intro}</p>
  <p class="rsvp-closed" hidden>{t.closed}</p>
  <p class="rsvp-spots" aria-live="polite" hidden></p>
  <p class="rsvp-banner" role="alert" hidden></p>

  <form
    class="rsvp-form"
    method="post"
    action={site.rsvpUrl}
    data-slug={cfg.slug}
    data-closes-at={cfg.closesAt}
    data-max-guests={cfg.maxGuests}
    data-session-label={cfg.session?.label}
    data-waitlist={cfg.session ? String(cfg.session.waitlist) : undefined}
    data-email={site.email}
    data-text={JSON.stringify(t)}
  >
    <input type="hidden" name="slug" value={event.slug} />
    <input type="hidden" name="mode" value="html" />
    <div class="visually-hidden" aria-hidden="true">
      <label>{t.honeypot}<input type="text" name="website" tabindex="-1" autocomplete="off" value="" /></label>
    </div>

    <p class="field">
      <label for="rsvp-name">{t.name}</label>
      <input id="rsvp-name" type="text" name="name" autocomplete="name" required />
      <span class="rsvp-error" id="err-name" data-error-for="name" hidden></span>
    </p>
    <p class="field">
      <label for="rsvp-email">{t.email}</label>
      <input id="rsvp-email" type="email" name="email" autocomplete="email" required />
      <span class="rsvp-error" id="err-email" data-error-for="email" hidden></span>
    </p>

    <fieldset class="group">
      <legend>{t.status}</legend>
      <span class="choices">
        {
          statuses.map((v) => (
            <label class="choice">
              <input type="radio" name="status" value={v} required />
              {t[v]}
            </label>
          ))
        }
      </span>
      <span class="rsvp-error" id="err-status" data-error-for="status" hidden></span>
    </fieldset>

    {
      session && (
        <fieldset class="group" data-attending data-going-only>
          <legend>{question}</legend>
          <span class="choices">
            {answers.map((v) => (
              <label class="choice">
                <input type="radio" name="session" value={v} />
                {t[v]}
              </label>
            ))}
          </span>
          <span class="rsvp-error" id="err-session" data-error-for="session" hidden />
        </fieldset>
      )
    }

    <fieldset class="group rsvp-guests" data-attending>
      <legend>{t.guestsHeading}</legend>
      <span class="help" data-help={fill(t.guestsHelpPlain, w)}>{guestsHelp}</span>
      {
        rows.map((n) => (
          <div class="guest" data-guest={n} hidden={n > NOJS_GUEST_ROWS}>
            <fieldset class="group">
              <legend>{fill(t.guestLegend, { n })}</legend>
              <span class="field">
                <label for={`rsvp-g${n}name`}>{t.guestName}</label>
                <input id={`rsvp-g${n}name`} type="text" name={`g${n}name`} autocomplete="off" />
                <span class="rsvp-error" id={`err-g${n}name`} data-error-for={`g${n}name`} hidden />
              </span>
              {session && (
                <fieldset class="group" data-going-only>
                  <legend>{question}</legend>
                  <span class="choices">
                    {answers.map((v) => (
                      <label class="choice">
                        <input type="radio" name={`g${n}session`} value={v} />
                        {t[v]}
                      </label>
                    ))}
                  </span>
                  <span class="rsvp-error" id={`err-g${n}session`} data-error-for={`g${n}session`} hidden />
                </fieldset>
              )}
              <button type="button" class="link-button guest-remove" hidden>
                {fill(t.removeGuest, { n })}
              </button>
            </fieldset>
          </div>
        ))
      }
      <button type="button" class="link-button guest-add" hidden>{t.addGuest}</button>
    </fieldset>

    <p class="optin">
      <label class="choice"><input type="checkbox" name="optin" value="yes" />{t.optIn}</label>
    </p>
    <button class="btn" type="submit">{t.submit}</button>
    <p class="rsvp-privacy">{t.privacy}</p>
  </form>

  <div class="rsvp-result" role="status" tabindex="-1" hidden>
    <h3 class="rsvp-result__title"></h3>
    <p class="rsvp-result__text"></p>
    {/* E9 (I-094, I-103, I-105): your answer, then a line by answer with a decorative emoji */}
    <p class="rsvp-result__status" hidden></p>
    <p class="rsvp-result__cheer" hidden><span class="rsvp-result__cheer-text"></span> <span class="rsvp-result__emoji" aria-hidden="true"></span></p>
    <ul class="rsvp-lines"></ul>
    <p class="rsvp-result__note" hidden></p>
    {/* E9 (I-096): the calendar, then each inResult notice's own link (the waiver), for Going and Maybe */}
    {/* E15 (Brian, Nov 8): less busy. The two calendar buttons are quiet outlines side by side; the notice button (the waiver) is the one solid button, on its own row. */}
    <div class="rsvp-result__actions" hidden>
      <div class="rsvp-result__row">
        <a class="btn btn--outline rsvp-result__calendar" href={googleUrl} target="_blank" rel="noopener" hidden>{t.calendarGoogle}</a>
        <a class="btn btn--outline rsvp-result__calendar" href={href(`/events/${event.slug}.ics`)} download hidden>{t.calendar}</a>
      </div>
      {
        notices.map((n) => (
          <div class="rsvp-result__row">
            <a class="btn rsvp-result__notice" href={n.link.url} target="_blank" rel="noopener" hidden>
              {n.link.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>

  {/* E6 (I-082): a sibling of the result, not inside it: role="status" is read whole, so a new tip would re-read the result. */}
  <div class="rsvp-tip" hidden>
    <h3 class="rsvp-tip__title">{t.tipTitle}</h3>
    {/* E9 (I-095): the window holds the live text; the aria-hidden reel spins over it */}
    <div class="rsvp-tip__window">
      <p class="rsvp-tip__text" aria-live="polite"></p>
    </div>
    <button type="button" class="link-button rsvp-tip__next" hidden>{t.tipNext}</button>
  </div>
</div>

<script>
  import '../../scripts/rsvp.ts';
</script>

<style>
  .rsvp {
    max-width: 36rem;
  }
  /* A class that sets `display` would otherwise beat the hidden attribute (.btn is inline-flex). */
  .rsvp [hidden] {
    display: none !important;
  }
  .rsvp-intro,
  .rsvp-closed,
  .rsvp-spots {
    margin-top: var(--s-2);
  }
  .rsvp-spots {
    font-weight: 600;
  }
  .rsvp-banner {
    margin-top: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border: 2px solid var(--terra-700);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .rsvp-form {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-6);
  }
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend,
  .field > label {
    display: block;
    padding: 0;
    margin-bottom: var(--s-1);
    font-weight: 600;
  }
  .field {
    display: block;
  }
  input[type='text'],
  input[type='email'] {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--bg-light);
    color: var(--text-on-light);
  }
  /* The focus ring stays (global :focus-visible); an invalid field gets a heavier terracotta border. */
  input[aria-invalid='true'] {
    border-color: var(--terra-700);
    box-shadow: 0 0 0 1px var(--terra-700);
  }
  .rsvp-error {
    display: block;
    margin-top: var(--s-1);
    color: var(--text-on-light);
    font-weight: 600;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-6);
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    font-weight: 400;
  }
  .choice input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--green-700);
  }
  .help {
    display: block;
    margin-bottom: var(--s-3);
  }
  .guest {
    padding: var(--s-4);
    border: 1px solid var(--line-light);
    border-radius: var(--radius);
  }
  .guest + .guest {
    margin-top: var(--s-3);
  }
  /* E5, I-086: the name is a span.field and the yoga question the next fieldset, so the old `.group + .group` never matched */
  .guest .field + .group {
    margin-top: var(--s-4);
  }
  .link-button {
    min-height: 44px;
    padding: var(--s-2) 0;
    border: 0;
    background: none;
    color: var(--link-on-light);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
  }
  .guest-add {
    display: block;
    margin-top: var(--s-2);
  }
  .rsvp-form .btn {
    justify-self: start;
  }
  .btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .rsvp-privacy {
    font-size: var(--fs-small);
  }
  .rsvp-result {
    position: relative; /* E9: the confetti's anchor */
    margin-top: var(--s-6);
    padding: var(--s-6);
    border: 1px solid var(--line-light);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .rsvp-result > * + * {
    margin-top: var(--s-3);
  }
  /* E9 (I-094, I-096, I-105) */
  .rsvp-result__status {
    font-weight: 600;
  }
  .rsvp-result__emoji {
    display: inline-block;
    transform-origin: 50% 80%;
  }
  .rsvp-result__actions {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-4);
  }
  .rsvp-result__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .rsvp-result__row:not(:has(> :not([hidden]))) {
    display: none;
  }
  /* quiet: an outline in the text colour, smaller than the solid button */
  .rsvp-result a.btn--outline {
    min-height: 44px;
    padding: var(--s-2) var(--s-4);
    border-color: var(--green-700);
    background: transparent;
    color: var(--green-700);
    font-size: var(--fs-small);
  }
  .rsvp-result a.btn--outline:hover {
    background: var(--green-700);
    border-color: var(--green-700);
    color: var(--cream);
  }
  .rsvp-result {
    scroll-margin-top: var(--s-8);
  }
  /* E9 (I-099), E15: added by the script to <body>, a fixed layer over the viewport; the origin is the top of the result card */
  :global(.rsvp-confetti) {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow: hidden;
    pointer-events: none;
    --spread: min(46vw, 30rem);
    --rise: 30vh;
  }
  :global(.rsvp-confetti i) {
    position: absolute;
    left: calc(var(--ox) - var(--z) / 2);
    top: var(--oy);
    width: var(--z);
    height: calc(var(--z) * 0.55);
    opacity: 0;
  }
  :global(.rsvp-confetti .s1) {
    height: var(--z);
    border-radius: 50%;
  }
  :global(.rsvp-confetti .s2) {
    height: calc(var(--z) * 0.25);
    width: calc(var(--z) * 1.8);
  }
  :global(.rsvp-confetti .c0) {
    background: var(--accent);
  }
  :global(.rsvp-confetti .c1) {
    background: var(--terra-700);
  }
  :global(.rsvp-confetti .c2) {
    background: var(--green-700);
  }
  :global(.rsvp-confetti .c3) {
    background: var(--green-300);
  }
  .rsvp-lines :global(.rsvp-answer--yes) {
    color: var(--green-700);
  }
  .rsvp-lines :global(.rsvp-answer--no) {
    color: var(--terra-700);
  }
  /* E9 (I-095): the Pricing rate card's look */
  .rsvp-tip {
    margin-top: var(--s-6);
    padding: var(--s-6);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-dark);
    color: var(--text-on-dark);
  }
  .rsvp-tip > * + * {
    margin-top: var(--s-3);
  }
  .rsvp-tip__title::after {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    margin-top: var(--s-3);
    background: var(--accent);
  }
  .rsvp-tip__next {
    color: var(--text-on-dark);
  }
  .rsvp-tip__window {
    position: relative;
    overflow: hidden;
  }
  .rsvp-tip__window :global(.rsvp-tip__reel) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg-dark);
  }
  .rsvp-tip__window :global(.rsvp-tip__reel-item) {
    height: var(--h);
    overflow: hidden;
  }
  /* Motion set three (§A3, the eleventh to thirteenth exceptions): one-shot, decoration only; with reduced motion the
     script adds no confetti or reel and the emoji sits still. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.rsvp-confetti i) {
      animation: ohm-confetti 3400ms linear var(--d) forwards;
    }
    .rsvp-result__emoji--maybe {
      animation: ohm-wiggle 1s ease-out;
    }
    .rsvp-result__emoji--cant {
      animation: ohm-droop 1s ease-in-out;
    }
    .rsvp-tip__window :global(.rsvp-tip__reel--go .rsvp-tip__strip) {
      animation: ohm-reel var(--dur, 900ms) cubic-bezier(0.15, 0.6, 0.2, 1) forwards;
    }
    /* up and out fast (ease-out), then a slow tumbling fall (ease-in) past the whole viewport, fading at the end */
    @keyframes ohm-confetti {
      0% {
        opacity: 1;
        translate: 0 0;
        rotate: 0deg;
        animation-timing-function: cubic-bezier(0.1, 0.7, 0.3, 1);
      }
      30% {
        opacity: 1;
        translate: calc(var(--x) * var(--spread) * 0.75) calc(var(--y) * var(--rise));
        rotate: calc(var(--r) * 0.4);
        animation-timing-function: cubic-bezier(0.4, 0, 0.9, 0.6);
      }
      85% {
        opacity: 1;
      }
      100% {
        opacity: 0;
        translate: calc(var(--x) * var(--spread)) calc(var(--f) * 100vh);
        rotate: var(--r);
      }
    }
    @keyframes ohm-wiggle {
      0% {
        scale: 0;
        rotate: 0deg;
      }
      15% {
        scale: 1.15;
      }
      30% {
        scale: 1;
        rotate: 0deg;
      }
      44% {
        rotate: -12deg;
      }
      58% {
        rotate: 12deg;
      }
      72% {
        rotate: -12deg;
      }
      86% {
        rotate: 12deg;
      }
      100% {
        scale: 1;
        rotate: 0deg;
      }
    }
    @keyframes ohm-droop {
      0% {
        opacity: 0;
        rotate: 0deg;
        translate: 0 0;
      }
      25% {
        opacity: 1;
        rotate: 0deg;
        translate: 0 0;
      }
      55% {
        rotate: 14deg;
        translate: 0 2px;
      }
      100% {
        opacity: 1;
        rotate: 0deg;
        translate: 0 0;
      }
    }
    @keyframes ohm-reel {
      from {
        translate: 0 0;
      }
      to {
        translate: 0 calc(-1 * var(--steps) * var(--h));
      }
    }
  }
  .rsvp-lines {
    padding-left: 1.1em;
  }
  .rsvp-lines :global(li) + :global(li) {
    margin-top: var(--s-1);
  }
</style>
