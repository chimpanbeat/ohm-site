---
import type { Notice } from '../../data/events.ts';

interface Props {
  notice: Notice;
}

const { notice } = Astro.props;
---

<div class="event-notice" id={notice.id}>
  <h2>{notice.title}</h2>
  <p>{notice.text}</p>
  {
    notice.link && (
      <p>
        <a href={notice.link.url} target="_blank" rel="noopener">
          {notice.link.label}
        </a>
      </p>
    )
  }
</div>

<style>
  /* A light box on the green band (E4, I-080): it reads as part of the page, not the footer. */
  .event-notice {
    max-width: var(--measure);
    padding: var(--s-6);
    background: var(--bg-light);
    color: var(--text-on-light);
    border: 1px solid var(--green-300);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
  }
  .event-notice a {
    color: var(--link-on-light);
  }
  .event-notice + .event-notice {
    margin-top: var(--s-6);
  }
  h2 + p {
    margin-top: var(--s-2);
  }
  p + p {
    margin-top: var(--s-4);
  }
</style>
