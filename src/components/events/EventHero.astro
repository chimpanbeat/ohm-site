---
import { getImage } from 'astro:assets';
import { rsvpText, type SiteEvent } from '../../data/events.ts';
import { dateLabel, timeLabel, mapsUrl } from '../../lib/events.ts';
import { eventAsset, eventMark } from '../../lib/event-assets.ts';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const tz = event.timeZone;
// E10 (I-101): the countdown line exists only in a build made before the event ends; client script 6 fills it.
const showCountdown = Date.now() < Date.parse(event.end);
const wide = eventAsset(event.graphics.wide);
const narrow = eventAsset(event.graphics.narrow);
const mark = event.graphics.wideMark ? eventMark(event.graphics.wideMark) : undefined;

// Art direction as on About: the wide banner from 48rem, the narrow mark below. Never upscaled by the pipeline.
// E11 (I-104): the wide banner is banner-bg.png (1240x400, already the 31:10 view with its artwork filled in and a
// scrim baked in); the launch mark is drawn over it as inline SVG traced from launch-mark-on-dark.png, so the letters
// stay sharp. Interim until JohnMark sends a 2x file. `npm run event-banner` makes both.
const widthsOf = (src: ImageMetadata) => [Math.round(src.width * 0.5), src.width];
const make = (src: ImageMetadata, format: 'avif' | 'webp', widths = widthsOf(src)) => getImage({ src, format, widths });
const [wideAvif, wideWebp, narrowAvif, narrowWebp, fallback] = await Promise.all([
  make(wide, 'avif'),
  make(wide, 'webp'),
  make(narrow, 'avif'),
  make(narrow, 'webp'),
  getImage({ src: narrow, format: 'png', width: narrow.width }),
]);

const wideMedia = '(min-width: 48rem)';
const wideSizes = '(min-width: 72rem) 70rem, calc(100vw - 2rem)'; // the container's content width (E5)
const narrowSizes = `(min-width: 30rem) ${narrow.width}px, 100vw`;
---

<!-- width/height on every source reserve the box for each art direction (no layout shift). The graphic's words are its alt: the H1 no longer repeats them (E4). -->
<div class="event-banner">
<picture>
  <source media={wideMedia} type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideSizes} width={wide.width} height={wide.height} />
  <source media={wideMedia} type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={wideSizes} width={wide.width} height={wide.height} />
  <source type="image/avif" srcset={narrowAvif.srcSet.attribute} sizes={narrowSizes} width={narrow.width} height={narrow.height} />
  <source type="image/webp" srcset={narrowWebp.srcSet.attribute} sizes={narrowSizes} width={narrow.width} height={narrow.height} />
  <img src={fallback.src} width={narrow.width} height={narrow.height} alt={event.graphics.alt} loading="eager" decoding="async" fetchpriority="high" />
</picture>
{
  mark && (
    <svg
      class="event-banner__mark"
      viewBox={mark.viewBox}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      style={`left:${mark.box.left}%;top:${mark.box.top}%;width:${mark.box.width}%;height:${mark.box.height}%`}
    >
      <path class="mark-accent" fill-rule="evenodd" d={mark.accent} />
      <path class="mark-light" fill-rule="evenodd" d={mark.light} />
    </svg>
  )
}
</div>

<h1>{event.heading ?? event.title}</h1>

<div class="event-meta">
<p class="event-when">
  <time datetime={event.start}>{dateLabel(event.start, tz)}</time> · {timeLabel(event.start, event.end, tz, 'always')}
</p>
{
  showCountdown && (
    <p
      class="event-countdown"
      data-start={event.start}
      data-end={event.end}
      data-tz={tz}
      data-text={JSON.stringify({ days: rsvpText.countdownDays, tomorrow: rsvpText.countdownTomorrow, today: rsvpText.countdownToday })}
    />
  )
}
<p class="event-where">
  <a href={mapsUrl(event.venue)} target="_blank" rel="noopener">{event.venue.name}, {event.venue.address}</a>
</p>
</div>

<style>
  .event-banner {
    position: relative;
    margin-bottom: var(--s-6);
  }
  picture {
    display: block;
  }
  .event-banner__mark {
    display: none;
    position: absolute;
  }
  .event-banner__mark .mark-accent {
    fill: var(--accent);
  }
  .event-banner__mark .mark-light {
    fill: var(--text-on-dark);
  }
  picture img {
    display: block;
    width: 100%;
    max-width: 24rem;
    height: auto;
    margin-inline: auto;
  }
  .event-when {
    font-size: 1.25rem;
    font-weight: 600;
  }
  /* Brian, Nov 9: date and place on the left, the flip board on the right (below them on a phone). */
  .event-meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .event-countdown {
    grid-row: 3;
    margin-top: var(--s-3);
    /* Reserves the board's height before the script fills it (CLS 0) */
    min-height: 3.5rem;
    font-weight: 600;
  }
  @media (min-width: 48rem) {
    .event-meta {
      grid-template-columns: 1fr auto;
      column-gap: var(--s-8);
    }
    .event-when,
    .event-where {
      grid-column: 1;
    }
    .event-countdown {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      margin-top: 0;
    }
  }
  /* The board and its tiles are made by script 6, so these reach into it. A tile is two half-height panels; the flaps
     are the two that move (a falling top, a landing bottom), the other two hold the old and new characters. */
  .event-countdown :global(.event-countdown__sr) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .event-countdown :global(.event-countdown__board) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    --tile-w: 2.5rem;
    --tile-h: 3.5rem;
  }
  .event-countdown :global(.event-countdown__board[data-long='true']) {
    --tile-w: 1.75rem;
    --tile-h: 2.75rem;
  }
  .event-countdown :global(.event-countdown__word) {
    padding-inline: var(--s-2);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .event-countdown :global(.flip) {
    position: relative;
    display: inline-block;
    width: var(--tile-w);
    height: var(--tile-h);
    perspective: 12rem;
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: calc(var(--tile-h) * 0.72);
    font-weight: 700;
    line-height: var(--tile-h);
    color: var(--text-on-dark);
  }
  .event-countdown :global(.flip__h) {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    background: var(--ink);
    backface-visibility: hidden;
  }
  .event-countdown :global(.flip__top) {
    top: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    border-bottom: 1px solid var(--green-900);
    transform-origin: 50% 100%;
  }
  .event-countdown :global(.flip__bottom) {
    bottom: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    transform-origin: 50% 0;
  }
  .event-countdown :global(.flip__h b) {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--tile-h);
    text-align: center;
  }
  .event-countdown :global(.flip__top b) {
    top: 0;
  }
  .event-countdown :global(.flip__bottom b) {
    bottom: 0;
  }
  .event-countdown :global(.flip__flap-top),
  .event-countdown :global(.flip__flap-bottom) {
    visibility: hidden;
  }
  .event-countdown :global(.is-flipping .flip__flap-top) {
    visibility: visible;
    animation: flip-down 80ms ease-in forwards;
  }
  .event-countdown :global(.is-flipping .flip__flap-bottom) {
    visibility: visible;
    transform: rotateX(90deg);
    animation: flip-land 80ms 80ms ease-out forwards;
  }
  @keyframes flip-down {
    to {
      transform: rotateX(-90deg);
    }
  }
  @keyframes flip-land {
    from {
      transform: rotateX(90deg);
    }
    to {
      transform: rotateX(0deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-countdown :global(.flip__flap-top),
    .event-countdown :global(.flip__flap-bottom) {
      display: none;
    }
  }
  .event-where {
    margin-top: var(--s-2);
  }
  /* Wide banner, full column (E5, I-085; E11, I-104): banner-bg.png is already the 31:10 view of header-green.png
     (source x 190-810, y 125-325, art filled in, scrim baked in), so the picture only fills a 31:10 box the width of the
     container (its left edge is the H1's). The mark's SVG sits at the art's box, in percent of that box. */
  @media (min-width: 48rem) {
    picture {
      overflow: hidden;
      aspect-ratio: 31 / 10;
      width: 100%;
    }
    picture img {
      width: 100%;
      height: 100%;
      max-width: none;
      margin-inline: 0;
      object-fit: cover;
      object-position: 50% 50%;
    }
    .event-banner__mark {
      display: block;
    }
  }
</style>
