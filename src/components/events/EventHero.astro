---
import { getImage } from 'astro:assets';
import { rsvpText, type SiteEvent } from '../../data/events.ts';
import { dateLabel, timeLabel, mapsUrl, googleCalUrl } from '../../lib/events.ts';
import { eventAsset, eventMark } from '../../lib/event-assets.ts';
import { href } from '../../lib/url.ts';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const tz = event.timeZone;
const googleUrl = googleCalUrl(event, new URL(href('/'), Astro.site).href); // E14
// E10 (I-101): the countdown line exists only in a build made before the event ends; client script 6 fills it.
const showCountdown = Date.now() < Date.parse(event.end);
const wide = eventAsset(event.graphics.wide);
const narrow = eventAsset(event.graphics.narrow);
const mark = event.graphics.wideMark ? eventMark(event.graphics.wideMark) : undefined;

// Art direction as on About: the wide banner from 48rem, the narrow mark below. Never upscaled by the pipeline.
// E11 (I-104): the wide banner is banner-bg.png (1240x400, already the 31:10 view with its artwork filled in and a
// scrim baked in); the launch mark is drawn over it as inline SVG traced from launch-mark-on-dark.png, so the letters
// stay sharp. Interim until JohnMark sends a 2x file. `npm run event-banner` makes both.
const widthsOf = (src: ImageMetadata) => [Math.round(src.width * 0.5), src.width];
const make = (src: ImageMetadata, format: 'avif' | 'webp', widths = widthsOf(src)) => getImage({ src, format, widths });
const [wideAvif, wideWebp, narrowAvif, narrowWebp, fallback] = await Promise.all([
  make(wide, 'avif'),
  make(wide, 'webp'),
  make(narrow, 'avif'),
  make(narrow, 'webp'),
  getImage({ src: narrow, format: 'png', width: narrow.width }),
]);

const wideMedia = '(min-width: 48rem)';
const wideSizes = '(min-width: 72rem) 70rem, calc(100vw - 2rem)'; // the container's content width (E5)
const narrowSizes = `(min-width: 30rem) ${narrow.width}px, 100vw`;
---

<!-- width/height on every source reserve the box for each art direction (no layout shift). The graphic's words are its alt: the H1 no longer repeats them (E4). -->
<div class="event-banner">
<picture>
  <source media={wideMedia} type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideSizes} width={wide.width} height={wide.height} />
  <source media={wideMedia} type="image/webp" srcset={wideWebp.srcSet.attribute} sizes={wideSizes} width={wide.width} height={wide.height} />
  <source type="image/avif" srcset={narrowAvif.srcSet.attribute} sizes={narrowSizes} width={narrow.width} height={narrow.height} />
  <source type="image/webp" srcset={narrowWebp.srcSet.attribute} sizes={narrowSizes} width={narrow.width} height={narrow.height} />
  <img src={fallback.src} width={narrow.width} height={narrow.height} alt={event.graphics.alt} loading="eager" decoding="async" fetchpriority="high" />
</picture>
{
  mark && (
    <svg
      class="event-banner__mark"
      viewBox={mark.viewBox}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      style={`left:${mark.box.left}%;top:${mark.box.top}%;width:${mark.box.width}%;height:${mark.box.height}%`}
    >
      <path class="mark-accent" fill-rule="evenodd" d={mark.accent} />
      <path class="mark-light" fill-rule="evenodd" d={mark.light} />
    </svg>
  )
}
</div>

<h1>{event.heading ?? event.title}</h1>

<p class="event-when">
  <time datetime={event.start}>{dateLabel(event.start, tz)}</time> · {timeLabel(event.start, event.end, tz, 'always')}
</p>
{
  showCountdown && (
    <p
      class="event-countdown"
      data-start={event.start}
      data-end={event.end}
      data-tz={tz}
      data-text={JSON.stringify({ days: rsvpText.countdownDays, tomorrow: rsvpText.countdownTomorrow, today: rsvpText.countdownToday })}
    />
  )
}
<p class="event-where">
  <a href={mapsUrl(event.venue)} target="_blank" rel="noopener">{event.venue.name}, {event.venue.address}</a>
</p>
<p class="event-actions">
  {event.rsvp && <a class="btn" href="#rsvp">{rsvpText.heading}</a>}
  <a class="btn btn--quiet" href={googleUrl} target="_blank" rel="noopener">{rsvpText.calendarGoogle}</a>
  <a class="btn btn--quiet" href={href(`/events/${event.slug}.ics`)} download>{rsvpText.calendar}</a>
</p>

<style>
  .event-banner {
    position: relative;
    margin-bottom: var(--s-6);
  }
  picture {
    display: block;
  }
  .event-banner__mark {
    display: none;
    position: absolute;
  }
  .event-banner__mark .mark-accent {
    fill: var(--accent);
  }
  .event-banner__mark .mark-light {
    fill: var(--text-on-dark);
  }
  picture img {
    display: block;
    width: 100%;
    max-width: 24rem;
    height: auto;
    margin-inline: auto;
  }
  .event-when {
    font-size: 1.25rem;
    font-weight: 600;
  }
  /* One line tall even when empty, so filling it shifts nothing (CLS 0) */
  .event-countdown {
    margin-top: var(--s-2);
    min-height: calc(1em * var(--lh-body));
    font-weight: 600;
  }
  .event-where {
    margin-top: var(--s-2);
  }
  .event-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  /* Wide banner, full column (E5, I-085; E11, I-104): banner-bg.png is already the 31:10 view of header-green.png
     (source x 190-810, y 125-325, art filled in, scrim baked in), so the picture only fills a 31:10 box the width of the
     container (its left edge is the H1's). The mark's SVG sits at the art's box, in percent of that box. */
  @media (min-width: 48rem) {
    picture {
      overflow: hidden;
      aspect-ratio: 31 / 10;
      width: 100%;
    }
    picture img {
      width: 100%;
      height: 100%;
      max-width: none;
      margin-inline: 0;
      object-fit: cover;
      object-position: 50% 50%;
    }
    .event-banner__mark {
      display: block;
    }
  }
</style>
