---
import { paymentMethodsLine, surchargeLine } from '../data/client-policies.ts';
import ColoradoNotice from './ColoradoNotice.astro';

interface Props {
  at?: 'book' | 'footnote' | 'cta';
}
const { at = 'cta' } = Astro.props;
---

<div class:list={['payment-notice', `payment-notice--${at}`]}>
  <p>{paymentMethodsLine}</p>
  <p>{surchargeLine}<ColoradoNotice /></p>
</div>

<style>
  .payment-notice {
    max-width: var(--measure);
  }
  .payment-notice > p + p {
    margin-top: var(--s-3);
  }
  /* On /book and /pricing it is a footnote to the page, not part of the booking flow: small and quieter. */
  .payment-notice--book,
  .payment-notice--footnote {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: color-mix(in srgb, var(--text-on-dark) 75%, var(--bg-dark));
  }
  /* A rule above it sets it apart from the page. On /book it also keeps its distance from the form. */
  .payment-notice--book,
  .payment-notice--footnote {
    padding-top: var(--s-6);
    border-top: 1px solid var(--line-dark);
  }
  .payment-notice--book {
    margin-top: var(--s-16);
  }
  .payment-notice--cta {
    margin-bottom: var(--s-6);
  }
</style>
