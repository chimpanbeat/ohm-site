---
import omega from '../data/omega.json';

interface Props {
  title: string;
  level?: 2 | 3;
}
const { title, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<details class="dropdown">
  <summary>
    <Heading>{title}</Heading>
    <span class="mark" aria-hidden="true">
      <span class="plus"></span>
      <svg viewBox={omega.viewBox} focusable="false"><path d={omega.d} /></svg>
    </span>
  </summary>
  <div class="dropdown__body"><slot /></div>
</details>

<style>
  .dropdown {
    max-width: var(--measure); /* keeps the marker next to the text, not at the page edge */
    border-bottom: 1px solid var(--line-light);
  }
  .dropdown summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 44px;
    padding-block: var(--s-3);
    cursor: pointer;
    list-style: none;
  }
  .dropdown summary::-webkit-details-marker {
    display: none;
  }
  .dropdown summary :global(h2),
  .dropdown summary :global(h3) {
    margin: 0;
  }
  .dropdown__body {
    padding-block: var(--s-2) var(--s-4);
  }
  .dropdown__body > :global(* + *) {
    margin-top: var(--s-3);
  }

  /* A plus that turns into the Ohm symbol when the item opens. */
  .mark {
    position: relative;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
  }
  .mark > * {
    position: absolute;
    inset: 0;
    transition:
      transform 300ms ease,
      opacity 300ms ease;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    top: calc(50% - 1px);
    height: 2px;
    background: currentColor;
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .mark svg {
    width: 100%;
    height: 100%;
    fill: var(--accent);
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  .dropdown[open] .plus {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .dropdown[open] .mark svg {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .mark > * {
      transition: none;
    }
  }
</style>
