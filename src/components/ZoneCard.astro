---
import { site, bookingUrl, type ZoneKey } from '../data/site.ts';
import ContactButtons from './ContactButtons.astro';
import DayChips from './DayChips.astro';

interface Props {
  zone: ZoneKey;
  headingLevel?: 2 | 3;
  /** How the visitor got here: typed an address, or picked an area. Only changes the out card's heading. */
  via?: 'address' | 'pick';
}

const { zone, headingLevel = 2, via = 'pick' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const z = site.zones[zone];
const book = z.linkKey ? bookingUrl(z.linkKey) : null;
---

<div class="card">
  {
    book ? (
      <>
        <Heading tabindex="-1">You're in my {z.name} area.</Heading>
        <DayChips days={z.days} />
        <p>
          Travel fee ${site.travelFee.amount}. {site.travelFee.note}
        </p>
        <p class="action">
          <a class="btn" href={book}>
            Book in this area
          </a>
        </p>
      </>
    ) : (
      <>
        <Heading tabindex="-1">
          {via === 'address' ? 'That address is outside my regular service area.' : 'Outside my regular service area'}
        </Heading>
        <p>I can sometimes travel outside my regular area by request.</p>
        <p>{site.outOfRegionFeeNote}</p>
        <ContactButtons />
      </>
    )
  }
</div>

<style>
  .card {
    padding: var(--s-6);
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
  }
  .card p {
    margin-top: var(--s-3);
  }
  .card :global(.days) {
    margin-top: var(--s-4);
  }
  .card .action {
    margin-top: var(--s-6);
  }
</style>
