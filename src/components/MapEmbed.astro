---
import { site } from '../data/site.ts';
---

{
  site.mapEmbedUrl && (
    <div class="map">
      <iframe loading="lazy" title="Ohm service area map" src={site.mapEmbedUrl} />
      <p>
        <a href={site.mapViewerUrl} target="_blank" rel="noopener">
          Open the map in Google Maps
        </a>
      </p>
    </div>
  )
}

<style>
  .map {
    margin-top: var(--s-8);
  }
  iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
  }
  p {
    margin-top: var(--s-3);
  }
  @media (min-width: 48rem) {
    iframe {
      aspect-ratio: 16 / 9;
    }
  }
</style>
