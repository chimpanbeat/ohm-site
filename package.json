{
  "name": "ohm-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "zones": "node scripts/kml-to-geojson.mjs",
    "osm": "node scripts/fetch-osm.mjs",
    "terrain": "node scripts/make-terrain.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "event-banner": "node scripts/make-event-banner.mjs",
    "omega": "node scripts/trace-omega.mjs",
    "event-images": "node scripts/make-event-credits.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:reviewer": "node tools/check-reviewer.mjs",
    "check": "npm run build && npm test && npm run check:wording && npm run check:contrast && npm run check:dist && npm run check:secrets && npm run check:reviewer",
    "shots": "node tools/shots.mjs",
    "metrics": "node tools/method-metrics.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "unpdf": "^2.0.0"
  }
}
