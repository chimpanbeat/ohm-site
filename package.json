{
  "name": "ohm-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "zones": "node scripts/kml-to-geojson.mjs",
    "osm": "node scripts/fetch-osm.mjs",
    "terrain": "node scripts/make-terrain.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "icons": "node scripts/make-icons.mjs",
    "omega": "node scripts/trace-omega.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "policies:pdf": "node scripts/make-policies-pdf.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "check": "npm run build && npm test && npm run check:wording && npm run check:contrast && npm run check:dist && npm run check:secrets",
    "shots": "node tools/shots.mjs --base /ohm-site",
    "metrics": "node tools/method-metrics.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
