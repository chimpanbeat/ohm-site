{
  "model": "sonnet",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Agent(model:*)",
      "Agent(effort:*)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm add *)",
      "Bash(npm update*)",
      "Bash(npm uninstall*)",
      "Edit(package.json)",
      "Edit(.claude/**)"
    ],
    "allow": [
      "Bash(npm run check*)",
      "Bash(npm ci)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check-before-commit.mjs"],
            "timeout": 600,
            "onFailure": "block",
            "statusMessage": "Running the check before commit"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/contract-guard.mjs"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
